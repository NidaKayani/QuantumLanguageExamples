<!DOCTYPE html>
<!-- Quantum HTML + CSS example 05_forms/20: Star rating input -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Star rating input</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .stars { display: inline-flex; flex-direction: row-reverse; border: 0; padding: 0; }
    .stars input { position: absolute; opacity: 0; }
    .stars label { font-size: 2.5rem; color: #cbd5e1; cursor: pointer; }
    .stars label:hover, .stars label:hover ~ label, .stars input:checked ~ label { color: #f59e0b; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Star rating input</h1>
    <p class="lead">Radio buttons drawn as stars; checked and hovered stars fill in.</p>
    <form action="#">
      <fieldset class="stars">
        <legend>Rate this example</legend>
        <input type="radio" id="s5" name="rating" value="5"><label for="s5" title="5 stars">&#9733;</label>
        <input type="radio" id="s4" name="rating" value="4" checked><label for="s4" title="4 stars">&#9733;</label>
        <input type="radio" id="s3" name="rating" value="3"><label for="s3" title="3 stars">&#9733;</label>
        <input type="radio" id="s2" name="rating" value="2"><label for="s2" title="2 stars">&#9733;</label>
        <input type="radio" id="s1" name="rating" value="1"><label for="s1" title="1 star">&#9733;</label>
      </fieldset>
    </form>
  </main>
</body>
</html>
