<!DOCTYPE html>
<!-- Quantum HTML + CSS example 05_forms/17: Toggle switch -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Toggle switch</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .switch { display: inline-flex; align-items: center; gap: 0.75rem; cursor: pointer; font-weight: 600; }
    .switch input { appearance: none; width: 3.25rem; height: 1.8rem; border-radius: 999px; background: #cbd5e1; position: relative; cursor: pointer; transition: background-color 0.2s; }
    .switch input::before { content: ""; position: absolute; top: 0.2rem; left: 0.2rem; width: 1.4rem; height: 1.4rem; border-radius: 50%; background: #fff; transition: transform 0.2s; }
    .switch input:checked { background: #22c55e; }
    .switch input:checked::before { transform: translateX(1.45rem); }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Toggle switch</h1>
    <p class="lead">A checkbox restyled as an on/off switch.</p>
    <label class="switch"><input type="checkbox" checked> Dark mode</label>
    <br><br>
    <label class="switch"><input type="checkbox"> Notifications</label>
  </main>
</body>
</html>
