<!DOCTYPE html>
<!-- Quantum HTML + CSS example 05_forms/06: Radio button survey -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Radio button survey</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .form { background: #fff; padding: 1.5rem; border-radius: 12px; max-width: 28rem; box-shadow: 0 4px 16px rgb(0 0 0 / 0.08); }
    .field { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 1rem; }
    label { font-weight: 600; font-size: 0.9rem; }
    input, select, textarea { font: inherit; padding: 0.6rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 8px; }
    input:focus, select:focus, textarea:focus { outline: 2px solid #3b82f6; outline-offset: 1px; border-color: #3b82f6; }
    button { font: inherit; padding: 0.7rem 1.25rem; border: 0; border-radius: 8px; background: #2563eb; color: #fff; font-weight: 600; cursor: pointer; }
    button:hover { background: #1d4ed8; }
    fieldset { border: 1px solid #e2e8f0; border-radius: 10px; padding: 1rem; margin: 0 0 1rem; }
    legend { font-weight: 700; padding: 0 0.4rem; }
    .option { display: flex; gap: 0.5rem; align-items: center; margin: 0.4rem 0; }
    input[type="radio"] { accent-color: #16a34a; width: 1.1rem; height: 1.1rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Radio button survey</h1>
    <p class="lead">One answer from a group, inside a fieldset.</p>
    <form class="form" action="#">
      <fieldset>
        <legend>How did you hear about us?</legend>
        <div class="option"><input type="radio" id="r1" name="source" checked><label for="r1">A friend</label></div>
        <div class="option"><input type="radio" id="r2" name="source"><label for="r2">Search engine</label></div>
        <div class="option"><input type="radio" id="r3" name="source"><label for="r3">Social media</label></div>
      </fieldset>
      <button type="submit">Submit</button>
    </form>
  </main>
</body>
</html>
