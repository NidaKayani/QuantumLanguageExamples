<!DOCTYPE html>
<!-- Quantum HTML + CSS example 05_forms/04: Search bar -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Search bar</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .search { display: flex; max-width: 32rem; background: #fff; border: 2px solid #cbd5e1; border-radius: 999px; overflow: hidden; }
    .search:focus-within { border-color: #6366f1; }
    .search input { flex: 1; border: 0; padding: 0.8rem 1.2rem; font: inherit; outline: none; }
    .search button { border: 0; background: #6366f1; color: #fff; padding: 0 1.4rem; font: inherit; cursor: pointer; }
    .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Search bar</h1>
    <p class="lead">An input and button joined into one control.</p>
    <form class="search" role="search" action="#">
      <label for="q" class="visually-hidden">Search</label>
      <input id="q" type="search" placeholder="Search the docs&hellip;">
      <button type="submit">Search</button>
    </form>
  </main>
</body>
</html>
