<!DOCTYPE html>
<!-- Quantum HTML + CSS example 01_text_elements/17: Word break opportunities -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Word break opportunities</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .card { background: #fff; border-radius: 12px; padding: 1.5rem; box-shadow: 0 1px 3px rgb(0 0 0 / 0.12); }
    .narrow { width: 12rem; border: 1px dashed #94a3b8; padding: 0.5rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Word break opportunities</h1>
    <p class="lead">wbr marks where a long word may wrap.</p>
    <section class="card">
      <p class="narrow">Super<wbr>cali<wbr>fragilistic<wbr>expiali<wbr>docious</p>
      <p class="narrow">https://<wbr>example.com/<wbr>a/<wbr>very/<wbr>long/<wbr>path</p>
    </section>
  </main>
</body>
</html>
