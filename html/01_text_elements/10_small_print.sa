<!DOCTYPE html>
<!-- Quantum HTML + CSS example 01_text_elements/10: Small print -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Small print</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .card { background: #fff; border-radius: 12px; padding: 1.5rem; box-shadow: 0 1px 3px rgb(0 0 0 / 0.12); }
    .price { font-size: 2.5rem; font-weight: 700; margin: 0; }
    small { color: #64748b; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Small print</h1>
    <p class="lead">small is for side comments, legal text and captions.</p>
    <section class="card">
      <p class="price">$9.99 <small>/ month</small></p>
      <p><small>Prices include VAT. Cancel any time. Offer valid until 31 December.</small></p>
    </section>
  </main>
</body>
</html>
