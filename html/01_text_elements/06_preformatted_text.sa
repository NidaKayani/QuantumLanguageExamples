<!DOCTYPE html>
<!-- Quantum HTML + CSS example 01_text_elements/06: Preformatted text -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Preformatted text</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .card { background: #fff; border-radius: 12px; padding: 1.5rem; box-shadow: 0 1px 3px rgb(0 0 0 / 0.12); }
    pre {
      margin: 0;
      padding: 1rem;
      overflow-x: auto;
      background: #0f172a;
      color: #e2e8f0;
      border-radius: 8px;
      tab-size: 4;
    }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Preformatted text</h1>
    <p class="lead">pre keeps every space and line break as written.</p>
    <section class="card">
      <pre><code>fn greet(name) {
        print("Hello, " + name)
    }

    greet("Quantum")</code></pre>
    </section>
  </main>
</body>
</html>
