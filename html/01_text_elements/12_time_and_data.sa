<!DOCTYPE html>
<!-- Quantum HTML + CSS example 01_text_elements/12: Time and data -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Time and data</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .card { background: #fff; border-radius: 12px; padding: 1.5rem; box-shadow: 0 1px 3px rgb(0 0 0 / 0.12); }
    time, data { border-bottom: 1px dashed #94a3b8; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Time and data</h1>
    <p class="lead">Machine-readable values behind human-readable text.</p>
    <section class="card">
      <p>The launch is on <time datetime="2026-12-01T09:00">1 December at 9 am</time>.</p>
      <p>Our best seller: <data value="SKU-2041">the travel mug</data>.</p>
      <p>Talks last <time datetime="PT45M">45 minutes</time>.</p>
    </section>
  </main>
</body>
</html>
