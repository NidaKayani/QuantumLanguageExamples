<!DOCTYPE html>
<!-- Quantum HTML + CSS example 01_text_elements/11: Insertions and deletions -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Insertions and deletions</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .card { background: #fff; border-radius: 12px; padding: 1.5rem; box-shadow: 0 1px 3px rgb(0 0 0 / 0.12); }
    del { color: #b91c1c; }
    ins { color: #047857; text-decoration-style: double; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Insertions and deletions</h1>
    <p class="lead">del and ins record what changed in a document.</p>
    <section class="card">
      <p>Meeting moved to <del datetime="2026-11-01">Monday</del> <ins datetime="2026-11-02">Tuesday</ins>.</p>
      <ul>
        <li><del>Buy milk</del></li>
        <li><ins>Buy oat milk</ins></li>
      </ul>
    </section>
  </main>
</body>
</html>
