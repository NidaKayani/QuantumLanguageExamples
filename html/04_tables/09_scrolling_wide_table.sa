<!DOCTYPE html>
<!-- Quantum HTML + CSS example 04_tables/09: Scrolling wide table -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Scrolling wide table</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    table { border-collapse: collapse; width: 100%; background: #fff; }
    th, td { padding: 0.6rem 0.9rem; border-bottom: 1px solid #e2e8f0; text-align: left; }
    th { background: #f8fafc; font-weight: 600; }
    .wrap { overflow-x: auto; }
    table { min-width: 48rem; }
    td, th { white-space: nowrap; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Scrolling wide table</h1>
    <p class="lead">A wrapper with overflow-x keeps wide tables usable on phones.</p>
    <div class="wrap">
      <table>
        <thead><tr><th>Jan</th><th>Feb</th><th>Mar</th><th>Apr</th><th>May</th><th>Jun</th><th>Jul</th><th>Aug</th><th>Sep</th><th>Oct</th><th>Nov</th><th>Dec</th></tr></thead>
        <tbody><tr><td>10</td><td>13</td><td>16</td><td>19</td><td>22</td><td>25</td><td>28</td><td>31</td><td>34</td><td>37</td><td>40</td><td>43</td></tr><tr><td>40</td><td>38</td><td>36</td><td>34</td><td>32</td><td>30</td><td>28</td><td>26</td><td>24</td><td>22</td><td>20</td><td>18</td></tr></tbody>
      </table>
    </div>
  </main>
</body>
</html>
