<!DOCTYPE html>
<!-- Quantum HTML + CSS example 04_tables/06: Colspan and rowspan -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Colspan and rowspan</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    table { border-collapse: collapse; width: 100%; background: #fff; }
    th, td { padding: 0.6rem 0.9rem; border-bottom: 1px solid #e2e8f0; text-align: left; }
    th { background: #f8fafc; font-weight: 600; }
    td, th { border: 1px solid #cbd5e1; text-align: center; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Colspan and rowspan</h1>
    <p class="lead">Cells that span several columns or rows.</p>
    <table>
      <thead>
        <tr><th rowspan="2">Day</th><th colspan="2">Morning</th><th colspan="2">Afternoon</th></tr>
        <tr><th>9:00</th><th>11:00</th><th>14:00</th><th>16:00</th></tr>
      </thead>
      <tbody>
        <tr><td>Monday</td><td colspan="2">Workshop</td><td>Lunch talk</td><td>Review</td></tr>
        <tr><td>Tuesday</td><td>Stand-up</td><td>Coding</td><td colspan="2">Hackathon</td></tr>
      </tbody>
    </table>
  </main>
</body>
</html>
