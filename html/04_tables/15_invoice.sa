<!DOCTYPE html>
<!-- Quantum HTML + CSS example 04_tables/15: Invoice -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Invoice</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    table { border-collapse: collapse; width: 100%; background: #fff; }
    th, td { padding: 0.6rem 0.9rem; border-bottom: 1px solid #e2e8f0; text-align: left; }
    th { background: #f8fafc; font-weight: 600; }
    .invoice { background: #fff; padding: 1.5rem; border-radius: 12px; }
    td:nth-child(n+2), th:nth-child(n+2) { text-align: right; }
    tfoot td { border: 0; }
    tfoot tr:last-child td { font-size: 1.2rem; font-weight: 700; border-top: 2px solid #0f172a; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Invoice</h1>
    <p class="lead">Line items with a subtotal, tax and total.</p>
    <section class="invoice">
      <h2>Invoice #2026-114</h2>
      <table>
        <thead><tr><th>Description</th><th>Qty</th><th>Price</th><th>Amount</th></tr></thead>
        <tbody>
        <tr><td>Website design</td><td>1</td><td>$1200.00</td><td>$1200.00</td></tr>
        <tr><td>Hosting (12 months)</td><td>12</td><td>$15.00</td><td>$180.00</td></tr>
        <tr><td>Logo</td><td>1</td><td>$300.00</td><td>$300.00</td></tr>
        </tbody>
        <tfoot>
          <tr><td colspan="3">Subtotal</td><td>$1680.00</td></tr>
          <tr><td colspan="3">Tax (10%)</td><td>$168.00</td></tr>
          <tr><td colspan="3">Total</td><td>$1848.00</td></tr>
        </tfoot>
      </table>
    </section>
  </main>
</body>
</html>
