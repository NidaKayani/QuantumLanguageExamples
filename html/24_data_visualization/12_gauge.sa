<!DOCTYPE html>
<!-- Quantum HTML + CSS example 24_data_visualization/12: Gauge -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Gauge</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .gauge { position: relative; width: 16rem; height: 8rem; overflow: hidden; }
    .gauge .arc { width: 16rem; height: 16rem; border-radius: 50%; background: conic-gradient(from -90deg, #22c55e 0 60deg, #facc15 60deg 120deg, #ef4444 120deg 180deg, transparent 180deg); }
    .gauge .arc::after { content: ""; position: absolute; left: 3rem; top: 3rem; width: 10rem; height: 10rem; border-radius: 50%; background: #f5f7fa; }
    .needle { position: absolute; left: 50%; bottom: 0; width: 4px; height: 7rem; margin-left: -2px; background: #0f172a; transform-origin: bottom center; transform: rotate(35deg); border-radius: 2px; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Gauge</h1>
    <p class="lead">A half-circle gauge with a rotated needle.</p>
    <div class="gauge" role="img" aria-label="Speed in the yellow zone"><div class="arc"></div><div class="needle"></div></div>
  </main>
</body>
</html>
