<!DOCTYPE html>
<!-- Quantum HTML + CSS example 24_data_visualization/13: Activity heatmap -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Activity heatmap</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .heat { display: grid; grid-template-rows: repeat(7, 0.9rem); grid-auto-flow: column; grid-auto-columns: 0.9rem; gap: 3px; padding: 1rem; background: #fff; border-radius: 14px; width: max-content; }
    .heat span { border-radius: 2px; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Activity heatmap</h1>
    <p class="lead">A contribution calendar of 140 days, generated.</p>
    <div class="heat" role="img" aria-label="Commits over the last 20 weeks"><span style="background: #9be9a8" title="3 commits"></span><span style="background: #ebedf0" title="0 commits"></span><span style="background: #9be9a8" title="3 commits"></span><span style="background: #30a14e" title="9 commits"></span><span style="background: #ebedf0" title="0 commits"></span><span style="background: #ebedf0" title="0 commits"></span><span style="background: #216e39" title="12 commits"></span><span style="background: #40c463" title="6 commits"></span><span style="background: #ebedf0" title="0 commits"></span><span style="background: #9be9a8" title="3 commits"></span><span style="background: #40c463" title="6 commits"></span><span style="background: #ebedf0" title="0 commits"></span><span style="background: #40c463" title="6 commits"></span><span style="background: #ebedf0" title="0 commits"></span><span style="background: #ebedf0" title="0 commits"></span><span style="background: #ebedf0" title="0 commits"></span><span style="background: #9be9a8" title="3 commits"></span><span style="background: #9be9a8" title="3 commits"></span><span style="background: #ebedf0" title="0 commits"></span><span style="background: #ebedf0" title="0 commits"></span><span style="background: #ebedf0" title="0 commits"></span><span style="background: #40c463" title="6 commits"></span><span style="background: #9be9a8" title="3 commits"></span><span style="background: #ebedf0" title="0 commits"></span><span style="background: #216e39" title="12 commits"></span><span style="background: #40c463" title="6 commits"></span><span style="background: #ebedf0" title="0 commits"></span><span style="background: #ebedf0" title="0 commits"></span><span style="background: #30a14e" title="9 commits"></span><span style="background: #30a14e" title="9 commits"></span><span style="background: #40c463" title="6 commits"></span><span style="background: #ebedf0" title="0 commits"></span><span style="background: #40c463"