<!DOCTYPE html>
<!-- Quantum HTML + CSS example 24_data_visualization/09: Pie chart with conic-gradient -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pie chart with conic-gradient</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .pie { width: 14rem; height: 14rem; border-radius: 50%; background: conic-gradient(#6366f1 0% 40%, #f59e0b 40% 65%, #10b981 65% 80%, #ec4899 80% 100%); }
    .wrap { display: flex; gap: 2rem; align-items: center; flex-wrap: wrap; }
    .key { list-style: none; padding: 0; }
    .key li { margin: 0.4rem 0; }
    .key span { display: inline-block; width: 0.9rem; height: 0.9rem; border-radius: 3px; margin-right: 0.4rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Pie chart with conic-gradient</h1>
    <p class="lead">Slices from colour stops, no SVG needed.</p>
    <div class="wrap"><div class="pie" role="img" aria-label="Monthly budget"></div><ul class="key"><li><span style="background: #6366f1"></span>Rent 40%</li><li><span style="background: #f59e0b"></span>Food 25%</li><li><span style="background: #10b981"></span>Travel 15%</li><li><span style="background: #ec4899"></span>Fun 20%</li></ul></div>
  </main>
</body>
</html>
