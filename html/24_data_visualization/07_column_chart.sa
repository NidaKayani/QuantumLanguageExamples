<!DOCTYPE html>
<!-- Quantum HTML + CSS example 24_data_visualization/07: Column chart -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Column chart</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .cols { display: flex; align-items: flex-end; gap: 1rem; height: 16rem; padding: 1rem; background: #fff; border-radius: 16px; border-bottom: 3px solid #334155; }
    .cols div { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; height: 100%; }
    .cols span.bar { width: 100%; height: var(--h); background: #14b8a6; border-radius: 8px 8px 0 0; }
    .cols b { font-size: 0.85rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Column chart</h1>
    <p class="lead">Vertical columns with values on top.</p>
    <div class="cols" role="img" aria-label="Quarterly sales rising to 78 in Q4">
      <div><b>30</b><span class="bar" style="--h: 30%"></span>Q1</div>
      <div><b>55</b><span class="bar" style="--h: 55%"></span>Q2</div>
      <div><b>42</b><span class="bar" style="--h: 42%"></span>Q3</div>
      <div><b>78</b><span class="bar" style="--h: 78%"></span>Q4</div>
    </div>
  </main>
</body>
</html>
