<!DOCTYPE html>
<!-- Quantum HTML + CSS example 24_data_visualization/20: Bubble chart -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Bubble chart</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .art { background: #fff; border-radius: 16px; padding: 1rem; } .art svg { display: block; width: 100%; max-width: 30rem; height: auto; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Bubble chart</h1>
    <p class="lead">Popularity, satisfaction and size in one SVG.</p>
    <div class="art"><svg viewBox="0 0 400 200" role="img" aria-label="Languages by popularity and satisfaction">
      <line x1="20" y1="190" x2="390" y2="190" stroke="#cbd5e1"/><line x1="20" y1="10" x2="20" y2="190" stroke="#cbd5e1"/>
      <circle cx="352" cy="71" r="30" fill="#3ca7dd" fill-opacity="0.75"><title>Python</title></circle><text x="352" y="75" text-anchor="middle" font-size="11">Python</text><circle cx="306" cy="45" r="26" fill="#3c3cdd" fill-opacity="0.75"><title>JavaScript</title></circle><text x="306" y="49" text-anchor="middle" font-size="11">JavaScript</text><circle cx="183" cy="88" r="18" fill="#a73cdd" fill-opacity="0.75"><title>Java</title></circle><text x="183" y="92" text-anchor="middle" font-size="11">Java</text><circle cx="157" cy="62" r="15" fill="#dd3ca7" fill-opacity="0.75"><title>C++</title></circle><text x="157" y="66" text-anchor="middle" font-size="11">C++</text><circle cx="79" cy="96" r="9" fill="#dd3c3c" fill-opacity="0.75"><title>Ruby</title></circle><text x="79" y="100" text-anchor="middle" font-size="11">Ruby</text><circle cx="59" cy="28" r="7" fill="#dda73c" fill-opacity="0.75"><title>Quantum</title></circle><text x="59" y="32" text-anchor="middle" font-size="11">Quantum</text>
    </svg></div>
  </main>
</body>
</html>
