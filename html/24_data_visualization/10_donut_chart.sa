<!DOCTYPE html>
<!-- Quantum HTML + CSS example 24_data_visualization/10: Donut chart -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Donut chart</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .donut { width: 13rem; height: 13rem; border-radius: 50%; background: conic-gradient(#22c55e 0 72%, #e2e8f0 72% 100%); display: grid; place-items: center; position: relative; }
    .donut::before { content: ""; position: absolute; inset: 1.6rem; border-radius: 50%; background: #f5f7fa; }
    .donut b { position: relative; font-size: 2rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Donut chart</h1>
    <p class="lead">A conic gradient with a hole punched by radial-gradient mask.</p>
    <div class="donut" role="img" aria-label="72 percent complete"><b>72%</b></div>
  </main>
</body>
</html>
