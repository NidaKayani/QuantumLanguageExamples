<!DOCTYPE html>
<!-- Quantum HTML + CSS example 25_css_art_games/04: Playing card -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Playing card</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .card { position: relative; width: 10rem; height: 14rem; border-radius: 14px; background: #fff; box-shadow: 0 6px 18px rgb(0 0 0 / 0.15); color: #dc2626; font-family: Georgia, serif; }
    .corner { position: absolute; font-size: 1.3rem; line-height: 1; text-align: center; font-weight: 700; }
    .tl { top: 0.6rem; left: 0.6rem; } .br { bottom: 0.6rem; right: 0.6rem; transform: rotate(180deg); }
    .suit { position: absolute; inset: 0; display: grid; place-items: center; font-size: 5rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Playing card</h1>
    <p class="lead">An ace of hearts with corner indices.</p>
    <div class="card" role="img" aria-label="Ace of hearts"><span class="corner tl">A<br>&hearts;</span><span class="suit">&hearts;</span><span class="corner br">A<br>&hearts;</span></div>
  </main>
</body>
</html>
