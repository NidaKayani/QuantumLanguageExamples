<!DOCTYPE html>
<!-- Quantum HTML + CSS example 25_css_art_games/14: Solar system -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Solar system</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .space { position: relative; height: 24rem; border-radius: 20px; background: radial-gradient(#1e1b4b, #020617); display: grid; place-items: center; overflow: hidden; }
    .sun { width: 3rem; height: 3rem; border-radius: 50%; background: radial-gradient(#fef08a, #f59e0b); box-shadow: 0 0 30px #f59e0b; }
    .orbit { position: absolute; width: calc(var(--r) * 2); height: calc(var(--r) * 2); border: 1px solid rgb(255 255 255 / 0.15); border-radius: 50%; animation: orbit var(--t) linear infinite; }
    .orbit span { position: absolute; top: -0.5rem; left: 50%; border-radius: 50%; }
    @keyframes orbit { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) { .orbit { animation: none; } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Solar system</h1>
    <p class="lead">Planets orbiting a sun at different speeds.</p>
    <div class="space" role="img" aria-label="Planets orbiting the sun"><div class="sun"></div><div class="orbit" style="--r: 4rem; --t: 3s"><span style="width: 0.6rem; height: 0.6rem; background: #a8a29e"></span></div><div class="orbit" style="--r: 6rem; --t: 5s"><span style="width: 0.9rem; height: 0.9rem; background: #fbbf24"></span></div><div class="orbit" style="--r: 8rem; --t: 8s"><span style="width: 1.0rem; height: 1.0rem; background: #3b82f6"></span></div><div class="orbit" style="--r: 10rem; --t: 12s"><span style="width: 0.7rem; height: 0.7rem; background: #ef4444"></span></div></div>
  </main>
</body>
</html>
