<!DOCTYPE html>
<!-- Quantum HTML + CSS example 25_css_art_games/09: Crescent moon -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Crescent moon</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .night { padding: 3rem; border-radius: 20px; background: radial-gradient(circle at 70% 30%, #1e3a8a, #020617); }
    .moon { width: 9rem; height: 9rem; border-radius: 50%; box-shadow: 1.8rem 1rem 0 0 #fef9c3; }
    .star { position: absolute; width: 4px; height: 4px; border-radius: 50%; background: #fff; }
    .night { position: relative; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Crescent moon</h1>
    <p class="lead">A circle with a shadow circle cut out of it.</p>
    <div class="night" role="img" aria-label="A crescent moon at night"><div class="moon"></div><span class="star" style="left: 70%; top: 20%"></span><span class="star" style="left: 85%; top: 60%"></span><span class="star" style="left: 55%; top: 75%"></span></div>
  </main>
</body>
</html>
