<!DOCTYPE html>
<!-- Quantum HTML + CSS example 25_css_art_games/19: Snake game board -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Snake game board</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .snake-board { display: grid; grid-template-columns: repeat(12, 1.6rem); gap: 2px; padding: 6px; background: #14532d; border-radius: 10px; width: max-content; }
    .snake-board span { height: 1.6rem; border-radius: 4px; background: #166534; }
    .snake-board .snake { background: #86efac; }
    .snake-board .head { background: #facc15; }
    .snake-board .food { background: #ef4444; border-radius: 50%; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Snake game board</h1>
    <p class="lead">A 12 by 10 board with the snake and its food.</p>
    <div class="snake-board" role="img" aria-label="A snake game in progress"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span class="snake"></span><span class="snake"></span><span class="snake"></span><span class="snake"></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span class="snake"></span><span></span><span></span><span class="head"></span><span></span><span></span><span></span><span></span><span></span><span></span><span class="snake"></span><span class="snake"></span><span class="snake"></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span class="food"></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div><p>Score: 6</p>
  </main>
</body>
</html>
