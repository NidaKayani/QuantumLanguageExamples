<!DOCTYPE html>
<!-- Quantum HTML + CSS example 25_css_art_games/18: Game start screen -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Game start screen</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .screen { min-height: 22rem; display: grid; place-items: center; text-align: center; border-radius: 20px; color: #fff; background: radial-gradient(circle at 50% 120%, #7c3aed, #0f172a 60%); }
    .screen h2 { font-size: clamp(2.2rem, 7vw, 4rem); margin: 0; letter-spacing: 0.08em; text-shadow: 0 0 20px #a855f7; }
    .start { margin-top: 1.5rem; padding: 0.9rem 2rem; border: 0; border-radius: 999px; background: #facc15; color: #1e1b4b; font: inherit; font-weight: 900; letter-spacing: 0.1em; cursor: pointer; animation: glow 1.5s ease-in-out infinite alternate; }
    @keyframes glow { from { box-shadow: 0 0 0 0 rgb(250 204 21 / 0.6); } to { box-shadow: 0 0 0 14px rgb(250 204 21 / 0); } }
    @media (prefers-reduced-motion: reduce) { .start { animation: none; } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Game start screen</h1>
    <p class="lead">A title screen with a glowing start button.</p>
    <section class="screen"><div><h2>STAR QUEST</h2><p>Collect every star before the night ends.</p><button class="start" type="button">PRESS START</button></div></section>
  </main>
</body>
</html>
