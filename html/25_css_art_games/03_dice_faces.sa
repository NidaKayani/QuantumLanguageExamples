<!DOCTYPE html>
<!-- Quantum HTML + CSS example 25_css_art_games/03: Dice faces -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dice faces</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .dice { display: flex; gap: 1rem; flex-wrap: wrap; }
    .die { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.25rem; width: 5rem; height: 5rem; padding: 0.6rem; border-radius: 14px; background: #fff; box-shadow: 0 4px 10px rgb(0 0 0 / 0.15); }
    .die span { border-radius: 50%; }
    .die .on { background: #0f172a; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Dice faces</h1>
    <p class="lead">Six dice drawn with a 3 by 3 grid of pips.</p>
    <div class="dice">
      <div class="die" role="img" aria-label="1"><span></span><span></span><span></span><span></span><span class="on"></span><span></span><span></span><span></span><span></span></div>
      <div class="die" role="img" aria-label="2"><span class="on"></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span class="on"></span></div>
      <div class="die" role="img" aria-label="3"><span class="on"></span><span></span><span></span><span></span><span class="on"></span><span></span><span></span><span></span><span class="on"></span></div>
      <div class="die" role="img" aria-label="4"><span class="on"></span><span></span><span class="on"></span><span></span><span></span><span></span><span class="on"></span><span></span><span class="on"></span></div>
      <div class="die" role="img" aria-label="5"><span class="on"></span><span></span><span class="on"></span><span></span><span class="on"></span><span></span><span class="on"></span><span></span><span class="on"></span></div>
      <div class="die" role="img" aria-label="6"><span class="on"></span><span></span><span class="on"></span><span class="on"></span><span></span><span class="on"></span><span class="on"></span><span></span><span class="on"></span></div>
    </div>
  </main>
</body>
</html>
