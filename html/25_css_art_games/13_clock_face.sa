<!DOCTYPE html>
<!-- Quantum HTML + CSS example 25_css_art_games/13: Clock face -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Clock face</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .clock { position: relative; width: 14rem; height: 14rem; border-radius: 50%; background: #fff; border: 8px solid #1e293b; }
    .clock > span { position: absolute; left: 50%; top: 0.4rem; bottom: 50%; width: 4px; margin-left: -2px; transform-origin: bottom center; }
    .clock > span::before { content: ""; display: block; height: 1rem; background: #1e293b; border-radius: 2px; }
    .hour, .minute { position: absolute; left: 50%; bottom: 50%; transform-origin: bottom center; border-radius: 4px; background: #1e293b; }
    .hour { width: 6px; height: 3.5rem; margin-left: -3px; transform: rotate(305deg); }
    .minute { width: 4px; height: 5.5rem; margin-left: -2px; transform: rotate(60deg); }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Clock face</h1>
    <p class="lead">Hour marks placed by rotation, hands set to 10:10.</p>
    <div class="clock" role="img" aria-label="A clock showing ten past ten"><span style="transform: rotate(0deg)"></span><span style="transform: rotate(30deg)"></span><span style="transform: rotate(60deg)"></span><span style="transform: rotate(90deg)"></span><span style="transform: rotate(120deg)"></span><span style="transform: rotate(150deg)"></span><span style="transform: rotate(180deg)"></span><span style="transform: rotate(210deg)"></span><span style="transform: rotate(240deg)"></span><span style="transform: rotate(270deg)"></span><span style="transform: rotate(300deg)"></span><span style="transform: rotate(330deg)"></span><div class="hour"></div><div class="minute"></div></div>
  </main>
</body>
</html>
