<!DOCTYPE html>
<!-- Quantum HTML + CSS example 03_links_navigation/17: Mobile menu toggle -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mobile menu toggle</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .toggle { position: absolute; opacity: 0; }
    .burger { display: inline-block; cursor: pointer; padding: 0.5rem 1rem; background: #0f172a; color: #fff; border-radius: 8px; }
    .drawer { display: none; flex-direction: column; margin-top: 0.5rem; background: #fff; border-radius: 12px; padding: 0.5rem; box-shadow: 0 8px 24px rgb(0 0 0 / 0.12); }
    .drawer a { padding: 0.75rem; color: #0f172a; text-decoration: none; border-radius: 8px; }
    .drawer a:hover { background: #f1f5f9; }
    .toggle:checked ~ .drawer { display: flex; }
    .toggle:focus-visible + .burger { outline: 3px solid #f59e0b; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Mobile menu toggle</h1>
    <p class="lead">A checkbox and :checked open a menu without JavaScript.</p>
    <nav aria-label="Main">
      <input class="toggle" type="checkbox" id="menu">
      <label class="burger" for="menu">&#9776; Menu</label>
      <div class="drawer">
        <a href="#home" aria-current="page">Home</a>
        <a href="#docs">Docs</a>
        <a href="#examples">Examples</a>
        <a href="#blog">Blog</a>
        <a href="#about">About</a>
      </div>
    </nav>
  </main>
</body>
</html>
