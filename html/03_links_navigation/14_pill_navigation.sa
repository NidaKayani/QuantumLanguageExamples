<!DOCTYPE html>
<!-- Quantum HTML + CSS example 03_links_navigation/14: Pill navigation -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pill navigation</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .pills { display: inline-flex; gap: 0.25rem; padding: 0.3rem; background: #e2e8f0; border-radius: 999px; }
    .pills a { padding: 0.45rem 1.1rem; border-radius: 999px; color: #334155; text-decoration: none; }
    .pills a[aria-current="page"] { background: #fff; box-shadow: 0 1px 3px rgb(0 0 0 / 0.2); color: #0f172a; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Pill navigation</h1>
    <p class="lead">Rounded pills, the current one filled.</p>
    <nav class="pills" aria-label="View">
      <a href="#day">Day</a>
      <a href="#week" aria-current="page">Week</a>
      <a href="#month">Month</a>
      <a href="#year">Year</a>
    </nav>
  </main>
</body>
</html>
