<!DOCTYPE html>
<!-- Quantum HTML + CSS example 03_links_navigation/05: Vertical sidebar navigation -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Vertical sidebar navigation</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .sidebar { width: 14rem; background: #fff; border-radius: 12px; padding: 0.75rem; display: flex; flex-direction: column; }
    .sidebar a { color: #334155; text-decoration: none; padding: 0.6rem 0.9rem; border-radius: 8px; }
    .sidebar a:hover { background: #f1f5f9; }
    .sidebar a[aria-current="page"] { background: #eef2ff; color: #4338ca; font-weight: 600; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Vertical sidebar navigation</h1>
    <p class="lead">A column of links for a dashboard.</p>
    <nav class="sidebar" aria-label="Sections">
        <a href="#home">Home</a>
        <a href="#docs">Docs</a>
        <a href="#examples" aria-current="page">Examples</a>
        <a href="#blog">Blog</a>
        <a href="#about">About</a>
    </nav>
  </main>
</body>
</html>
