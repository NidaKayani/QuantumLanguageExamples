<!DOCTYPE html>
<!-- Quantum HTML + CSS example 03_links_navigation/10: Skip to content link -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Skip to content link</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .skip { position: absolute; left: 1rem; top: -4rem; background: #111827; color: #fff; padding: 0.75rem 1rem; border-radius: 8px; }
    .skip:focus { top: 1rem; }
    nav { margin-bottom: 1rem; }
    nav a { margin-right: 1rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Skip to content link</h1>
    <p class="lead">Hidden until focused, it lets keyboard users jump past the menu.</p>
    <a class="skip" href="#content">Skip to content</a>
    <nav aria-label="Main">
        <a href="#home" aria-current="page">Home</a>
        <a href="#docs">Docs</a>
        <a href="#examples">Examples</a>
        <a href="#blog">Blog</a>
        <a href="#about">About</a>
    </nav>
    <section id="content" tabindex="-1">
      <p>Press Tab on this page: the first thing you reach is the skip link.</p>
    </section>
  </main>
</body>
</html>
