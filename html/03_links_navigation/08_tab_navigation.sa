<!DOCTYPE html>
<!-- Quantum HTML + CSS example 03_links_navigation/08: Tab navigation -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Tab navigation</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .tabs { display: flex; border-bottom: 2px solid #e2e8f0; }
    .tabs a { padding: 0.75rem 1.25rem; color: #64748b; text-decoration: none; margin-bottom: -2px; border-bottom: 2px solid transparent; }
    .tabs a:hover { color: #0f172a; }
    .tabs a[aria-current="page"] { color: #2563eb; border-bottom-color: #2563eb; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Tab navigation</h1>
    <p class="lead">Tabs that underline the current one.</p>
    <nav class="tabs" aria-label="Account">
      <a href="#profile" aria-current="page">Profile</a>
      <a href="#billing">Billing</a>
      <a href="#security">Security</a>
      <a href="#notifications">Notifications</a>
    </nav>
  </main>
</body>
</html>
