<!DOCTYPE html>
<!-- Quantum HTML + CSS example 03_links_navigation/06: Breadcrumbs -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Breadcrumbs</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .crumbs ol { display: flex; flex-wrap: wrap; list-style: none; padding: 0; margin: 0; }
    .crumbs li + li::before { content: "/"; margin: 0 0.6rem; color: #94a3b8; }
    .crumbs a { color: #2563eb; text-decoration: none; }
    .crumbs [aria-current] { color: #64748b; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Breadcrumbs</h1>
    <p class="lead">Where the page sits in the site, separators drawn with CSS.</p>
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="#home">Home</a></li>
        <li><a href="#docs">Docs</a></li>
        <li><a href="#css">CSS</a></li>
        <li><span aria-current="page">Selectors</span></li>
      </ol>
    </nav>
  </main>
</body>
</html>
