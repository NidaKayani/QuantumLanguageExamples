<!DOCTYPE html>
<!-- Quantum HTML + CSS example 03_links_navigation/15: Icon navigation -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Icon navigation</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .icons { display: flex; justify-content: space-around; background: #fff; border-radius: 16px; padding: 0.75rem; box-shadow: 0 4px 12px rgb(0 0 0 / 0.08); }
    .icons a { display: flex; flex-direction: column; align-items: center; gap: 0.25rem; color: #64748b; text-decoration: none; font-size: 0.8rem; }
    .icons a[aria-current="page"] { color: #2563eb; }
    .icons svg { width: 1.6rem; height: 1.6rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Icon navigation</h1>
    <p class="lead">Navigation with inline SVG icons and labels.</p>
    <nav class="icons" aria-label="App">
      <a href="#home" aria-current="page"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 11l9-8 9 8v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>Home</a>
      <a href="#search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>Search</a>
      <a href="#saved"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4z"/></svg>Saved</a>
      <a href="#me"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>Me</a>
    </nav>
  </main>
</body>
</html>
