<!DOCTYPE html>
<!-- Quantum HTML + CSS example 23_semantics_accessibility/02: Article and section -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Article and section</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .panel { background: #fff; border-radius: 14px; padding: 1.25rem 1.5rem; margin-bottom: 1rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Article and section</h1>
    <p class="lead">Self-contained articles with their own sections.</p>
    <article class="panel">
      <h2>How bees make honey</h2>
      <section><h3>Collecting nectar</h3><p>Worker bees visit flowers and store nectar in a second stomach.</p></section>
      <section><h3>Turning nectar into honey</h3><p>Back at the hive, enzymes and fanning wings thicken it.</p></section>
    </article>
  </main>
</body>
</html>
