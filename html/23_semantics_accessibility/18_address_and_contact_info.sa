<!DOCTYPE html>
<!-- Quantum HTML + CSS example 23_semantics_accessibility/18: Address and contact info -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Address and contact info</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .panel { background: #fff; border-radius: 14px; padding: 1.25rem 1.5rem; margin-bottom: 1rem; }
    address { font-style: normal; line-height: 1.8; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Address and contact info</h1>
    <p class="lead">address for contact details, time for opening hours.</p>
    <section class="panel"><h2>Library</h2>
      <address>Central Library<br>Shahrah-e-Quaid-e-Azam, Lahore<br><a href="mailto:info@library.example">info@library.example</a></address>
      <p>Open <time datetime="09:00">9 am</time> to <time datetime="20:00">8 pm</time>.</p>
    </section>
  </main>
</body>
</html>
