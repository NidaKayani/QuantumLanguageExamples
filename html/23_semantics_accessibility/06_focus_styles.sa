<!DOCTYPE html>
<!-- Quantum HTML + CSS example 23_semantics_accessibility/06: Focus styles -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Focus styles</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .panel { background: #fff; border-radius: 14px; padding: 1.25rem 1.5rem; margin-bottom: 1rem; }
    a, button, input { font: inherit; }
    :focus-visible { outline: 3px solid #f59e0b; outline-offset: 3px; border-radius: 4px; }
    button { padding: 0.5rem 1rem; border: 1px solid #94a3b8; border-radius: 8px; background: #fff; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Focus styles</h1>
    <p class="lead">:focus-visible draws a clear ring for keyboard users only.</p>
    <section class="panel"><p>Press Tab to move between these:</p>
    <a href="#a">A link</a> <button type="button">A button</button> <input aria-label="A field" placeholder="A field"></section>
  </main>
</body>
</html>
