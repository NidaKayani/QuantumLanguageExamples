<!DOCTYPE html>
<!-- Quantum HTML + CSS example 23_semantics_accessibility/10: Disclosure widget -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Disclosure widget</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .panel { background: #fff; border-radius: 14px; padding: 1.25rem 1.5rem; margin-bottom: 1rem; }
    summary { cursor: pointer; font-weight: 700; }
    summary:focus-visible { outline: 3px solid #6366f1; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Disclosure widget</h1>
    <p class="lead">details and summary: keyboard and screen reader support for free.</p>
    <section class="panel"><details><summary>Show the shipping policy</summary><p>Orders ship within two working days.</p></details></section>
  </main>
</body>
</html>
