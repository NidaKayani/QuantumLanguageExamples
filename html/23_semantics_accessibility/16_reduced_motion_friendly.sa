<!DOCTYPE html>
<!-- Quantum HTML + CSS example 23_semantics_accessibility/16: Reduced motion friendly -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Reduced motion friendly</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .panel { background: #fff; border-radius: 14px; padding: 1.25rem 1.5rem; margin-bottom: 1rem; }
    .slide { animation: in 0.6s ease-out; }
    @keyframes in { from { transform: translateY(1rem); opacity: 0; } }
    @media (prefers-reduced-motion: reduce) { .slide { animation: none; } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Reduced motion friendly</h1>
    <p class="lead">Motion is opt-out for people who prefer less of it.</p>
    <section class="panel slide"><p>This card slides in, unless your system asks for reduced motion.</p></section>
  </main>
</body>
</html>
