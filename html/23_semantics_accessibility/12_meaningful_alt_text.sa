<!DOCTYPE html>
<!-- Quantum HTML + CSS example 23_semantics_accessibility/12: Meaningful alt text -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Meaningful alt text</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .panel { background: #fff; border-radius: 14px; padding: 1.25rem 1.5rem; margin-bottom: 1rem; }
    .panel img { width: 12rem; height: auto; border-radius: 10px; display: block; margin: 0.5rem 0; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Meaningful alt text</h1>
    <p class="lead">Describe what matters; empty alt for decoration.</p>
    <section class="panel">
      <h2>Informative image</h2>
      <img src="https://picsum.photos/seed/dog/400/300" alt="A golden retriever catching a frisbee" width="400" height="300">
      <h2>Decorative image</h2>
      <img src="https://picsum.photos/seed/swirl/400/120" alt="" width="400" height="120">
    </section>
  </main>
</body>
</html>
