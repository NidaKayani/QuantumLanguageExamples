<!DOCTYPE html>
<!-- Quantum HTML + CSS example 23_semantics_accessibility/05: Visually hidden text -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Visually hidden text</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .panel { background: #fff; border-radius: 14px; padding: 1.25rem 1.5rem; margin-bottom: 1rem; }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
    .icon-btn { width: 2.75rem; height: 2.75rem; border-radius: 50%; border: 1px solid #cbd5e1; background: #fff; font-size: 1.2rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Visually hidden text</h1>
    <p class="lead">Text for screen readers that is hidden on screen.</p>
    <section class="panel">
      <button class="icon-btn" type="button"><span aria-hidden="true">&#128465;</span><span class="sr-only">Delete message</span></button>
      <p>The button shows an icon; screen readers announce &ldquo;Delete message&rdquo;.</p>
    </section>
  </main>
</body>
</html>
