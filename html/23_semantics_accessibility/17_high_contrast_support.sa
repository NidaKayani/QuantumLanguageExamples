<!DOCTYPE html>
<!-- Quantum HTML + CSS example 23_semantics_accessibility/17: High contrast support -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>High contrast support</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .panel { background: #fff; border-radius: 14px; padding: 1.25rem 1.5rem; margin-bottom: 1rem; }
    .toggle { display: inline-block; width: 3rem; height: 1.6rem; border-radius: 999px; background: #22c55e; position: relative; }
    .toggle::after { content: ""; position: absolute; right: 0.2rem; top: 0.2rem; width: 1.2rem; height: 1.2rem; border-radius: 50%; background: #fff; }
    @media (forced-colors: active) { .toggle { border: 2px solid CanvasText; } .toggle::after { background: CanvasText; } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>High contrast support</h1>
    <p class="lead">forced-colors keeps controls visible in Windows high contrast mode.</p>
    <section class="panel"><p><span class="toggle" role="img" aria-label="Switched on"></span> Notifications on</p></section>
  </main>
</body>
</html>
