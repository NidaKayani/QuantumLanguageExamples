<!DOCTYPE html>
<!-- Quantum HTML + CSS example 23_semantics_accessibility/03: Heading outline -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Heading outline</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .panel { background: #fff; border-radius: 14px; padding: 1.25rem 1.5rem; margin-bottom: 1rem; }
    .outline h2, .outline h3, .outline h4 { margin: 0.4rem 0; }
    .outline h3 { padding-left: 1.5rem; } .outline h4 { padding-left: 3rem; color: #475569; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Heading outline</h1>
    <p class="lead">One h1, then levels without skipping.</p>
    <section class="panel outline">
      <h2>Getting started</h2>
      <h3>Installing</h3><h4>On Windows</h4><h4>On Linux</h4>
      <h3>Your first page</h3>
      <h2>Reference</h2>
    </section>
  </main>
</body>
</html>
