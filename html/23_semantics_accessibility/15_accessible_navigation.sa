<!DOCTYPE html>
<!-- Quantum HTML + CSS example 23_semantics_accessibility/15: Accessible navigation -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Accessible navigation</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    nav { margin-bottom: 1rem; }
    nav ul { display: flex; gap: 1rem; list-style: none; padding: 0; }
    nav a[aria-current="page"] { font-weight: 800; text-decoration-thickness: 3px; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Accessible navigation</h1>
    <p class="lead">aria-label names navs; aria-current marks the page you are on.</p>
    <nav aria-label="Main"><ul><li><a href="#home">Home</a></li><li><a href="#shop" aria-current="page">Shop</a></li><li><a href="#help">Help</a></li></ul></nav>
    <nav aria-label="Footer"><ul><li><a href="#privacy">Privacy</a></li><li><a href="#terms">Terms</a></li></ul></nav>
  </main>
</body>
</html>
