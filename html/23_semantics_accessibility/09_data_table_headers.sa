<!DOCTYPE html>
<!-- Quantum HTML + CSS example 23_semantics_accessibility/09: Data table headers -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Data table headers</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .panel { background: #fff; border-radius: 14px; padding: 1.25rem 1.5rem; margin-bottom: 1rem; }
    table { border-collapse: collapse; width: 100%; }
    th, td { padding: 0.5rem; border-bottom: 1px solid #e2e8f0; text-align: left; }
    caption { text-align: left; font-weight: 700; padding-bottom: 0.5rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Data table headers</h1>
    <p class="lead">scope on th and a caption make tables readable aloud.</p>
    <section class="panel"><table>
      <caption>Rainfall in millimetres</caption>
      <thead><tr><td></td><th scope="col">Spring</th><th scope="col">Summer</th><th scope="col">Autumn</th></tr></thead>
      <tbody><tr><th scope="row">Lahore</th><td>40</td><td>480</td><td>60</td></tr><tr><th scope="row">Quetta</th><td>90</td><td>20</td><td>10</td></tr></tbody>
    </table></section>
  </main>
</body>
</html>
