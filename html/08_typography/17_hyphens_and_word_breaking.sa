<!DOCTYPE html>
<!-- Quantum HTML + CSS example 08_typography/17: Hyphens and word breaking -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Hyphens and word breaking</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .cols { display: flex; gap: 1rem; }
    .cols p { width: 9rem; background: #fff; padding: 0.5rem; border: 1px solid #cbd5e1; }
    .auto { hyphens: auto; }
    .anywhere { overflow-wrap: anywhere; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Hyphens and word breaking</h1>
    <p class="lead">Letting long words break inside narrow columns.</p>
    <div class="cols" lang="en">
      <p>Extraordinarily incomprehensible internationalisation</p>
      <p class="auto">Extraordinarily incomprehensible internationalisation</p>
      <p class="anywhere">https://example.com/averyveryverylongpathwithnobreaks</p>
    </div>
  </main>
</body>
</html>
