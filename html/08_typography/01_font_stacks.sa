<!DOCTYPE html>
<!-- Quantum HTML + CSS example 08_typography/01: Font stacks -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Font stacks</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .stack p { font-size: 1.4rem; margin: 0.5rem 0; padding: 0.75rem 1rem; background: #fff; border-radius: 8px; }
    .serif { font-family: Georgia, "Times New Roman", serif; }
    .sans { font-family: Helvetica, Arial, sans-serif; }
    .mono { font-family: ui-monospace, Consolas, monospace; }
    .system { font-family: system-ui, sans-serif; }
    .cursive { font-family: "Comic Sans MS", cursive; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Font stacks</h1>
    <p class="lead">Serif, sans-serif, monospace and system stacks.</p>
    <div class="stack">
      <p class="serif">Serif: The quick brown fox jumps over the lazy dog</p>
      <p class="sans">Sans-serif: The quick brown fox jumps over the lazy dog</p>
      <p class="mono">Monospace: The quick brown fox jumps over the lazy dog</p>
      <p class="system">System UI: The quick brown fox jumps over the lazy dog</p>
      <p class="cursive">Cursive: The quick brown fox jumps over the lazy dog</p>
    </div>
  </main>
</body>
</html>
