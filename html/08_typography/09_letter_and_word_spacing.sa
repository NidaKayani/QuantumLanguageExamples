<!DOCTYPE html>
<!-- Quantum HTML + CSS example 08_typography/09: Letter and word spacing -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Letter and word spacing</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .sp p { font-size: 1.3rem; margin: 0.6rem 0; }
    .tight { letter-spacing: -0.04em; }
    .wide { letter-spacing: 0.2em; text-transform: uppercase; font-size: 0.9rem; }
    .words { word-spacing: 0.6em; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Letter and word spacing</h1>
    <p class="lead">Tracking for headings and labels.</p>
    <div class="sp">
      <p class="tight">Tight headline tracking</p>
      <p class="wide">Wide uppercase label</p>
      <p class="words">Extra space between words</p>
    </div>
  </main>
</body>
</html>
