<!DOCTYPE html>
<!-- Quantum HTML + CSS example 11_grid/05: auto-fill versus auto-fit -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>auto-fill versus auto-fit</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .grid { display: grid; gap: 0.5rem; }
    .grid > * { background: #0ea5e9; color: #fff; padding: 1rem; border-radius: 8px; font-weight: 600; }
    .grid { margin-bottom: 1rem; }
    .fill { grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr)); }
    .fit { grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr)); }
  </style>
</head>
<body>
  <main class="demo">
    <h1>auto-fill versus auto-fit</h1>
    <p class="lead">auto-fill keeps empty tracks; auto-fit collapses them.</p>
    <p>auto-fill</p><div class="grid fill"><div>One</div><div>Two</div></div>
    <p>auto-fit</p><div class="grid fit"><div>One</div><div>Two</div></div>
  </main>
</body>
</html>
