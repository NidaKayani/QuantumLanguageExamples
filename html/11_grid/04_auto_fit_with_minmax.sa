<!DOCTYPE html>
<!-- Quantum HTML + CSS example 11_grid/04: auto-fit with minmax -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>auto-fit with minmax</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .grid { display: grid; gap: 0.5rem; }
    .grid > * { background: #0ea5e9; color: #fff; padding: 1rem; border-radius: 8px; font-weight: 600; }
    .grid { grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); }
  </style>
</head>
<body>
  <main class="demo">
    <h1>auto-fit with minmax</h1>
    <p class="lead">As many 10rem columns as fit; resize the window.</p>
    <div class="grid">
      <div>Card 1</div>
      <div>Card 2</div>
      <div>Card 3</div>
      <div>Card 4</div>
      <div>Card 5</div>
      <div>Card 6</div>
      <div>Card 7</div>
      <div>Card 8</div>
      <div>Card 9</div>
    </div>
  </main>
</body>
</html>
