<!DOCTYPE html>
<!-- Quantum HTML + CSS example 11_grid/08: Dense packing -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dense packing</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .grid { display: grid; gap: 0.5rem; }
    .grid > * { background: #0ea5e9; color: #fff; padding: 1rem; border-radius: 8px; font-weight: 600; }
    .grid { grid-template-columns: repeat(auto-fill, minmax(6rem, 1fr)); grid-auto-rows: 5rem; grid-auto-flow: dense; }
    .w2 { grid-column: span 2; background: #8b5cf6; }
    .h2 { grid-row: span 2; background: #ef4444; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Dense packing</h1>
    <p class="lead">grid-auto-flow: dense fills the holes left by big items.</p>
    <div class="grid">
      <div>1</div><div class="w2">2</div><div>3</div><div class="h2">4</div><div class="w2">5</div>
      <div>6</div><div>7</div><div class="w2">8</div><div>9</div><div class="h2">10</div><div>11</div><div>12</div>
    </div>
  </main>
</body>
</html>
