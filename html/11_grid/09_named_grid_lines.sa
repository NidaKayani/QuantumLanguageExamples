<!DOCTYPE html>
<!-- Quantum HTML + CSS example 11_grid/09: Named grid lines -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Named grid lines</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .grid { display: grid; gap: 0.5rem; }
    .grid > * { background: #0ea5e9; color: #fff; padding: 1rem; border-radius: 8px; font-weight: 600; }
    .grid { grid-template-columns: [full-start] 1fr [content-start] 3fr [content-end] 1fr [full-end]; }
    .content { grid-column: content-start / content-end; background: #0d9488; }
    .full { grid-column: full-start / full-end; background: #334155; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Named grid lines</h1>
    <p class="lead">Lines named in the template, then used to place items.</p>
    <div class="grid">
      <div class="full">full width</div>
      <div class="content">content column</div>
      <div class="full">full width again</div>
    </div>
  </main>
</body>
</html>
