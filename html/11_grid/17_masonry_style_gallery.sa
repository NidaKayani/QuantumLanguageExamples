<!DOCTYPE html>
<!-- Quantum HTML + CSS example 11_grid/17: Masonry-style gallery -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Masonry-style gallery</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .wall { display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); grid-auto-rows: 1rem; gap: 0.5rem; }
    .wall div { border-radius: 10px; }
    .wall div:nth-child(1) { grid-row: span 12; background: #e46767; }
    .wall div:nth-child(2) { grid-row: span 18; background: #e4a667; }
    .wall div:nth-child(3) { grid-row: span 9; background: #e4e467; }
    .wall div:nth-child(4) { grid-row: span 15; background: #a6e467; }
    .wall div:nth-child(5) { grid-row: span 11; background: #67e467; }
    .wall div:nth-child(6) { grid-row: span 20; background: #67e4a6; }
    .wall div:nth-child(7) { grid-row: span 13; background: #67e4e4; }
    .wall div:nth-child(8) { grid-row: span 16; background: #67a6e4; }
    .wall div:nth-child(9) { grid-row: span 10; background: #6767e4; }
    .wall div:nth-child(10) { grid-row: span 14; background: #a667e4; }
    .wall div:nth-child(11) { grid-row: span 19; background: #e467e4; }
    .wall div:nth-child(12) { grid-row: span 8; background: #e467a6; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Masonry-style gallery</h1>
    <p class="lead">Rows of a few pixels and spans per item imitate masonry.</p>
    <div class="wall">
      <div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div>
    </div>
  </main>
</body>
</html>
