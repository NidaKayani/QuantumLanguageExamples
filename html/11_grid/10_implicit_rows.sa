<!DOCTYPE html>
<!-- Quantum HTML + CSS example 11_grid/10: Implicit rows -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Implicit rows</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .grid { display: grid; gap: 0.5rem; }
    .grid > * { background: #0ea5e9; color: #fff; padding: 1rem; border-radius: 8px; font-weight: 600; }
    .grid { grid-template-columns: repeat(3, 1fr); grid-auto-rows: minmax(4rem, auto); }
    .long { background: #ca8a04; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Implicit rows</h1>
    <p class="lead">grid-auto-rows sizes rows the template never mentions.</p>
    <div class="grid">
      <div>1</div><div class="long">This item has more text, so its row grows taller than the 4rem minimum.</div><div>3</div>
      <div>4</div><div>5</div><div>6</div>
    </div>
  </main>
</body>
</html>
