<!DOCTYPE html>
<!-- Quantum HTML + CSS example 11_grid/07: Spanning tracks -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Spanning tracks</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .grid { display: grid; gap: 0.5rem; }
    .grid > * { background: #0ea5e9; color: #fff; padding: 1rem; border-radius: 8px; font-weight: 600; }
    .grid { grid-template-columns: repeat(4, 1fr); grid-auto-rows: 5rem; }
    .wide { grid-column: span 2; background: #f97316; }
    .tall { grid-row: span 2; background: #16a34a; }
    .big { grid-column: 3 / 5; grid-row: 2 / 4; background: #db2777; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Spanning tracks</h1>
    <p class="lead">Items that span several columns and rows.</p>
    <div class="grid">
      <div class="wide">span 2 columns</div><div>3</div><div class="tall">span 2 rows</div>
      <div>5</div><div class="big">column 3 to 5, row 2 to 4</div><div>7</div><div>8</div>
    </div>
  </main>
</body>
</html>
