<!DOCTYPE html>
<!-- Quantum HTML + CSS example 11_grid/19: Responsive grid with media queries -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Responsive grid with media queries</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .grid { display: grid; gap: 0.5rem; }
    .grid > * { background: #0ea5e9; color: #fff; padding: 1rem; border-radius: 8px; font-weight: 600; }
    .grid { grid-template-columns: 1fr; }
    @media (min-width: 40rem) { .grid { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 64rem) { .grid { grid-template-columns: repeat(4, 1fr); } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Responsive grid with media queries</h1>
    <p class="lead">One column on phones, two on tablets, four on desktops.</p>
    <div class="grid">
      <div>Item 1</div>
      <div>Item 2</div>
      <div>Item 3</div>
      <div>Item 4</div>
      <div>Item 5</div>
      <div>Item 6</div>
      <div>Item 7</div>
      <div>Item 8</div>
    </div>
  </main>
</body>
</html>
