<!DOCTYPE html>
<!-- Quantum HTML + CSS example 14_pseudo_elements/11: Separators between items -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Separators between items</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .meta { list-style: none; padding: 0; display: flex; flex-wrap: wrap; color: #475569; }
    .meta li + li::before { content: "\00B7"; margin: 0 0.6rem; color: #94a3b8; font-weight: 700; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Separators between items</h1>
    <p class="lead">A dot drawn between inline items only.</p>
    <ul class="meta"><li>4 Nov 2026</li><li>6 min read</li><li>CSS</li><li>Layout</li></ul>
  </main>
</body>
</html>
