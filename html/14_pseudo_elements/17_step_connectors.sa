<!DOCTYPE html>
<!-- Quantum HTML + CSS example 14_pseudo_elements/17: Step connectors -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Step connectors</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .steps { display: flex; list-style: none; padding: 0; }
    .steps li { position: relative; flex: 1; text-align: center; padding-top: 2.5rem; }
    .steps li::before { content: ""; position: absolute; top: 0.5rem; left: 50%; width: 1.5rem; height: 1.5rem; margin-left: -0.75rem; border-radius: 50%; background: #10b981; z-index: 1; }
    .steps li::after { content: ""; position: absolute; top: 1.2rem; left: 50%; width: 100%; height: 3px; background: #a7f3d0; }
    .steps li:last-child::after { display: none; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Step connectors</h1>
    <p class="lead">Lines between steps drawn with ::after.</p>
    <ol class="steps"><li>Order</li><li>Packed</li><li>Shipped</li><li>Delivered</li></ol>
  </main>
</body>
</html>
