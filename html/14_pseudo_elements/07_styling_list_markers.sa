<!DOCTYPE html>
<!-- Quantum HTML + CSS example 14_pseudo_elements/07: Styling list markers -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Styling list markers</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .fancy li::marker { color: #e11d48; font-size: 1.3em; }
    .fancy ol li::marker { font-weight: 800; color: #2563eb; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Styling list markers</h1>
    <p class="lead">::marker changes the colour and size of bullets.</p>
    <div class="fancy">
      <ul><li>Red bullets</li><li>Bigger than the text</li></ul>
      <ol><li>Bold blue numbers</li><li>Same markup as always</li></ol>
    </div>
  </main>
</body>
</html>
