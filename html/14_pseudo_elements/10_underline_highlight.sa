<!DOCTYPE html>
<!-- Quantum HTML + CSS example 14_pseudo_elements/10: Underline highlight -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Underline highlight</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .hl { position: relative; z-index: 0; font-size: 2rem; font-weight: 800; }
    .hl::after { content: ""; position: absolute; left: -0.2rem; right: -0.2rem; bottom: 0.15em; height: 0.4em; background: #fde047; z-index: -1; transform: skewX(-12deg); border-radius: 4px; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Underline highlight</h1>
    <p class="lead">A thick highlighter stroke behind text with ::after.</p>
    <p>Learn <span class="hl">modern CSS</span> by example.</p>
  </main>
</body>
</html>
