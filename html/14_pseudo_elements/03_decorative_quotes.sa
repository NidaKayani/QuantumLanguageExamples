<!DOCTYPE html>
<!-- Quantum HTML + CSS example 14_pseudo_elements/03: Decorative quotes -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Decorative quotes</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .quote { position: relative; max-width: 34rem; padding: 2rem 2rem 1.5rem 4rem; background: #fff; border-radius: 14px; font-size: 1.2rem; }
    .quote::before { content: "\201C"; position: absolute; left: 1rem; top: -0.5rem; font-size: 6rem; line-height: 1; color: #c4b5fd; font-family: Georgia, serif; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Decorative quotes</h1>
    <p class="lead">Big quotation marks drawn with ::before.</p>
    <blockquote class="quote"><p>Simplicity is prerequisite for reliability.</p><footer>Edsger W. Dijkstra</footer></blockquote>
  </main>
</body>
</html>
