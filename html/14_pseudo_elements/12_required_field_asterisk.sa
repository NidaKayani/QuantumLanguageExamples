<!DOCTYPE html>
<!-- Quantum HTML + CSS example 14_pseudo_elements/12: Required field asterisk -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Required field asterisk</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .req::after { content: " *"; color: #dc2626; }
    .form label { display: block; margin-top: 0.75rem; font-weight: 600; }
    .form input { padding: 0.5rem; border: 1px solid #cbd5e1; border-radius: 6px; width: 18rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Required field asterisk</h1>
    <p class="lead">A red star after the labels of required fields.</p>
    <form class="form" action="#">
      <label class="req" for="u">Username</label><input id="u" required>
      <label for="w">Website</label><input id="w" type="url">
    </form>
  </main>
</body>
</html>
