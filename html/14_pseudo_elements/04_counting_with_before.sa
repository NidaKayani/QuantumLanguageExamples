<!DOCTYPE html>
<!-- Quantum HTML + CSS example 14_pseudo_elements/04: Counting with ::before -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Counting with ::before</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .doc { counter-reset: figure; }
    .doc figure { counter-increment: figure; margin: 1rem 0; padding: 1rem; background: #fff; border-radius: 12px; }
    .doc figcaption::before { content: "Figure " counter(figure) ": "; font-weight: 700; }
    .doc .shape { height: 5rem; border-radius: 8px; background: #bae6fd; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Counting with ::before</h1>
    <p class="lead">Figure numbers generated from a counter.</p>
    <div class="doc">
      <figure><div class="shape"></div><figcaption>A rectangle.</figcaption></figure>
      <figure><div class="shape"></div><figcaption>The same rectangle again.</figcaption></figure>
      <figure><div class="shape"></div><figcaption>And a third.</figcaption></figure>
    </div>
  </main>
</body>
</html>
