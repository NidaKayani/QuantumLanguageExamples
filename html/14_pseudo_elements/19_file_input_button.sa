<!DOCTYPE html>
<!-- Quantum HTML + CSS example 14_pseudo_elements/19: File input button -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>File input button</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .upload { padding: 1rem; background: #fff; border: 2px dashed #94a3b8; border-radius: 12px; }
    .upload::file-selector-button { border: 0; border-radius: 999px; padding: 0.5rem 1.2rem; margin-right: 1rem; background: #059669; color: #fff; font-weight: 700; cursor: pointer; }
    .upload::file-selector-button:hover { background: #047857; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>File input button</h1>
    <p class="lead">::file-selector-button restyles the button in a file field.</p>
    <form action="#"><label for="doc">Attach a document:</label> <input class="upload" id="doc" type="file"></form>
  </main>
</body>
</html>
