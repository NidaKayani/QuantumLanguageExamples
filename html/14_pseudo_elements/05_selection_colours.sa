<!DOCTYPE html>
<!-- Quantum HTML + CSS example 14_pseudo_elements/05: Selection colours -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Selection colours</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .select-me { font-size: 1.3rem; background: #fff; padding: 1rem; border-radius: 12px; }
    .select-me::selection { background: #f472b6; color: #fff; }
    .select-me strong::selection { background: #0f172a; color: #fde047; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Selection colours</h1>
    <p class="lead">::selection styles text the user selects.</p>
    <p class="select-me">Select this sentence with the mouse to see <strong>custom selection colours</strong> in action.</p>
  </main>
</body>
</html>
