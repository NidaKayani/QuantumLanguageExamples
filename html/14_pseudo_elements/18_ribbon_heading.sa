<!DOCTYPE html>
<!-- Quantum HTML + CSS example 14_pseudo_elements/18: Ribbon heading -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Ribbon heading</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .ribbon { position: relative; display: inline-block; margin: 1rem 2rem; padding: 0.6rem 2rem; background: #be123c; color: #fff; font-weight: 800; }
    .ribbon::before, .ribbon::after { content: ""; position: absolute; top: 0.4rem; border: 1.2rem solid #9f1239; z-index: -1; }
    .ribbon::before { left: -1.6rem; border-left-color: transparent; }
    .ribbon::after { right: -1.6rem; border-right-color: transparent; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Ribbon heading</h1>
    <p class="lead">Folded ribbon ends from ::before and ::after.</p>
    <h2 class="ribbon">Special offer</h2>
  </main>
</body>
</html>
