<!DOCTYPE html>
<!-- Quantum HTML + CSS example 14_pseudo_elements/20: Scrollbar styling -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Scrollbar styling</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .scroller { height: 12rem; overflow-y: scroll; padding: 1rem; background: #fff; border-radius: 12px; scrollbar-color: #8b5cf6 #ede9fe; scrollbar-width: thin; }
    .scroller p { height: 4rem; margin: 0 0 0.5rem; background: #f5f3ff; border-radius: 8px; padding: 0.5rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Scrollbar styling</h1>
    <p class="lead">scrollbar-color and scrollbar-width on a scrolling box.</p>
    <div class="scroller"><p>Row 1</p><p>Row 2</p><p>Row 3</p><p>Row 4</p><p>Row 5</p><p>Row 6</p><p>Row 7</p><p>Row 8</p></div>
  </main>
</body>
</html>
