<!DOCTYPE html>
<!-- Quantum HTML + CSS example 10_flexbox/14: flex-grow, shrink and basis -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>flex-grow, shrink and basis</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .row { display: flex; gap: 0.5rem; background: #e0e7ff; padding: 0.5rem; border-radius: 10px; min-height: 8rem; }
    .row div { background: #6366f1; color: #fff; padding: 0.75rem 1rem; border-radius: 8px; font-weight: 600; }
    .row { margin-bottom: 1rem; min-height: 0; }
    .g1 { flex-grow: 1; } .g2 { flex-grow: 2; } .g3 { flex-grow: 3; }
    .basis div { flex: 1 1 10rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>flex-grow, shrink and basis</h1>
    <p class="lead">How spare space is shared out.</p>
    <div class="row"><div class="g1">grow 1</div><div class="g2">grow 2</div><div class="g3">grow 3</div></div>
    <div class="row basis"><div>basis 10rem</div><div>basis 10rem</div><div>basis 10rem</div></div>
  </main>
</body>
</html>
