<!DOCTYPE html>
<!-- Quantum HTML + CSS example 10_flexbox/09: align-items: flex-end -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>align-items: flex-end</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .row { display: flex; gap: 0.5rem; background: #e0e7ff; padding: 0.5rem; border-radius: 10px; min-height: 8rem; }
    .row div { background: #6366f1; color: #fff; padding: 0.75rem 1rem; border-radius: 8px; font-weight: 600; }
    .a { align-items: flex-end; }
    .row div:nth-child(2) { font-size: 1.6rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>align-items: flex-end</h1>
    <p class="lead">Aligning items across the cross axis with flex-end.</p>
    <div class="row a">
      <div>One</div>
      <div>Two</div>
      <div>Three</div>
    </div>
  </main>
</body>
</html>
