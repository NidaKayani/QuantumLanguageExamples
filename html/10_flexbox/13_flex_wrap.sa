<!DOCTYPE html>
<!-- Quantum HTML + CSS example 10_flexbox/13: flex-wrap -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>flex-wrap</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .row { display: flex; gap: 0.5rem; background: #e0e7ff; padding: 0.5rem; border-radius: 10px; min-height: 8rem; }
    .row div { background: #6366f1; color: #fff; padding: 0.75rem 1rem; border-radius: 8px; font-weight: 600; }
    .wrap { flex-wrap: wrap; }
    .wrap div { flex: 0 0 9rem; text-align: center; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>flex-wrap</h1>
    <p class="lead">Items wrap onto new lines when they run out of room.</p>
    <div class="row wrap">
      <div>Item 1</div>
      <div>Item 2</div>
      <div>Item 3</div>
      <div>Item 4</div>
      <div>Item 5</div>
      <div>Item 6</div>
      <div>Item 7</div>
      <div>Item 8</div>
      <div>Item 9</div>
      <div>Item 10</div>
    </div>
  </main>
</body>
</html>
