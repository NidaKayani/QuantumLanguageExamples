<!DOCTYPE html>
<!-- Quantum HTML + CSS example 10_flexbox/20: Sticky footer -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sticky footer</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .page { display: flex; flex-direction: column; min-height: 22rem; background: #fff; border-radius: 12px; overflow: hidden; }
    .page header, .page footer { background: #0f172a; color: #fff; padding: 0.75rem 1rem; }
    .page main { flex: 1; padding: 1rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Sticky footer</h1>
    <p class="lead">A footer that stays at the bottom even on short pages.</p>
    <div class="page">
      <header>Header</header>
      <main><p>Not much content, yet the footer sits at the bottom.</p></main>
      <footer>Footer</footer>
    </div>
  </main>
</body>
</html>
