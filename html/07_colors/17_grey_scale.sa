<!DOCTYPE html>
<!-- Quantum HTML + CSS example 07_colors/17: Grey scale -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Grey scale</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .greys { display: flex; border-radius: 12px; overflow: hidden; }
    .greys div { flex: 1; height: 5rem; }
    .g0 { background: oklch(100% 0 0); }
    .g1 { background: oklch(90% 0 0); }
    .g2 { background: oklch(80% 0 0); }
    .g3 { background: oklch(70% 0 0); }
    .g4 { background: oklch(60% 0 0); }
    .g5 { background: oklch(50% 0 0); }
    .g6 { background: oklch(40% 0 0); }
    .g7 { background: oklch(30% 0 0); }
    .g8 { background: oklch(20% 0 0); }
    .g9 { background: oklch(10% 0 0); }
    .g10 { background: oklch(0% 0 0); }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Grey scale</h1>
    <p class="lead">Eleven greys from white to black in oklch.</p>
    <div class="greys">
      <div class="g0"></div><div class="g1"></div><div class="g2"></div><div class="g3"></div><div class="g4"></div><div class="g5"></div><div class="g6"></div><div class="g7"></div><div class="g8"></div><div class="g9"></div><div class="g10"></div>
    </div>
  </main>
</body>
</html>
