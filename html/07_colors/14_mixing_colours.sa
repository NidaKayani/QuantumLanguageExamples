<!DOCTYPE html>
<!-- Quantum HTML + CSS example 07_colors/14: Mixing colours -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mixing colours</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .mix { display: flex; border-radius: 12px; overflow: hidden; }
    .mix div { flex: 1; height: 6rem; display: grid; place-items: center; color: #fff; font-weight: 700; }
    .m0 { background: color-mix(in oklch, #2563eb 0%, #f43f5e); }
    .m20 { background: color-mix(in oklch, #2563eb 20%, #f43f5e); }
    .m40 { background: color-mix(in oklch, #2563eb 40%, #f43f5e); }
    .m60 { background: color-mix(in oklch, #2563eb 60%, #f43f5e); }
    .m80 { background: color-mix(in oklch, #2563eb 80%, #f43f5e); }
    .m100 { background: color-mix(in oklch, #2563eb 100%, #f43f5e); }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Mixing colours</h1>
    <p class="lead">color-mix blends two colours by percentage.</p>
    <div class="mix">
      <div class="m0">0%</div>
      <div class="m20">20%</div>
      <div class="m40">40%</div>
      <div class="m60">60%</div>
      <div class="m80">80%</div>
      <div class="m100">100%</div>
    </div>
  </main>
</body>
</html>
