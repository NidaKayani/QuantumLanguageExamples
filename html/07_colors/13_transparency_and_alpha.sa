<!DOCTYPE html>
<!-- Quantum HTML + CSS example 07_colors/13: Transparency and alpha -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Transparency and alpha</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .stage { position: relative; height: 16rem; background: repeating-conic-gradient(#e2e8f0 0 25%, #fff 0 50%) 0 0 / 2rem 2rem; border-radius: 12px; }
    .dot { position: absolute; width: 10rem; height: 10rem; border-radius: 50%; }
    .r { background: rgb(239 68 68 / 0.6); left: 2rem; top: 1rem; }
    .g { background: rgb(34 197 94 / 0.6); left: 8rem; top: 1rem; }
    .b { background: rgb(59 130 246 / 0.6); left: 5rem; top: 5.5rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Transparency and alpha</h1>
    <p class="lead">Alpha channels let layers show through each other.</p>
    <div class="stage"><div class="dot r"></div><div class="dot g"></div><div class="dot b"></div></div>
  </main>
</body>
</html>
