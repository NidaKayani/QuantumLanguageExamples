<!DOCTYPE html>
<!-- Quantum HTML + CSS example 07_colors/16: Colour harmonies -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Colour harmonies</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .scheme { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; }
    .scheme div { width: 6rem; height: 6rem; border-radius: 12px; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Colour harmonies</h1>
    <p class="lead">Complementary, triadic and analogous colours from one hue.</p>
    <h2>Complementary</h2>
    <div class="scheme"><div style="background: hsl(200 80% 50%)"></div><div style="background: hsl(20 80% 50%)"></div></div>
    <h2>Triadic</h2>
    <div class="scheme"><div style="background: hsl(200 80% 50%)"></div><div style="background: hsl(320 80% 50%)"></div><div style="background: hsl(80 80% 50%)"></div></div>
    <h2>Analogous</h2>
    <div class="scheme"><div style="background: hsl(170 80% 45%)"></div><div style="background: hsl(200 80% 50%)"></div><div style="background: hsl(230 80% 55%)"></div></div>
  </main>
</body>
</html>
