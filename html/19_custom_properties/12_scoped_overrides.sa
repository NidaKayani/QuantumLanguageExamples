<!DOCTYPE html>
<!-- Quantum HTML + CSS example 19_custom_properties/12: Scoped overrides -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Scoped overrides</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    :root { --tone: #2563eb; }
    .box { border: 3px solid var(--tone); color: var(--tone); padding: 1rem; border-radius: 10px; margin: 0.75rem 0; }
    .warning { --tone: #d97706; }
    .danger { --tone: #dc2626; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Scoped overrides</h1>
    <p class="lead">A variable set on a parent changes only its own subtree.</p>
    <div class="box">Default tone</div><div class="warning"><div class="box">Warning tone</div></div><div class="danger"><div class="box">Danger tone</div></div>
  </main>
</body>
</html>
