<!DOCTYPE html>
<!-- Quantum HTML + CSS example 19_custom_properties/11: Fallback values -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Fallback values</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .chip { display: inline-block; margin: 0.3rem; padding: 0.5rem 1rem; border-radius: 999px; background: var(--chip-bg, #e2e8f0); color: var(--chip-fg, #0f172a); }
    .hot { --chip-bg: #dc2626; --chip-fg: #fff; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Fallback values</h1>
    <p class="lead">var(--name, fallback) for properties that may be missing.</p>
    <span class="chip">uses the fallback</span><span class="chip hot">sets its own colours</span>
  </main>
</body>
</html>
