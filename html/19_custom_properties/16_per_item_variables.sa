<!DOCTYPE html>
<!-- Quantum HTML + CSS example 19_custom_properties/16: Per-item variables -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Per-item variables</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .bars { display: flex; gap: 0.4rem; align-items: flex-end; height: 10rem; }
    .bars span { flex: 1; height: calc(var(--i) * 10%); background: hsl(calc(var(--i) * 30) 70% 55%); border-radius: 6px 6px 0 0; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Per-item variables</h1>
    <p class="lead">An index variable on each item drives its delay and colour.</p>
    <div class="bars"><span style="--i: 1"></span><span style="--i: 2"></span><span style="--i: 3"></span><span style="--i: 4"></span><span style="--i: 5"></span><span style="--i: 6"></span><span style="--i: 7"></span><span style="--i: 8"></span><span style="--i: 9"></span><span style="--i: 10"></span></div>
  </main>
</body>
</html>
