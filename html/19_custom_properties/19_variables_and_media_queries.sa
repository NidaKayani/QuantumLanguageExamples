<!DOCTYPE html>
<!-- Quantum HTML + CSS example 19_custom_properties/19: Variables and media queries -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Variables and media queries</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    :root { --cols: 1; --gap: 0.5rem; }
    @media (min-width: 40rem) { :root { --cols: 2; --gap: 1rem; } }
    @media (min-width: 64rem) { :root { --cols: 3; --gap: 1.5rem; } }
    .grid { display: grid; grid-template-columns: repeat(var(--cols), 1fr); gap: var(--gap); }
    .grid div { padding: 1.5rem; background: #fda4af; border-radius: 10px; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Variables and media queries</h1>
    <p class="lead">Change a variable at a breakpoint, not every rule that uses it.</p>
    <div class="grid"><div>1</div><div>2</div><div>3</div><div>4</div><div>5</div><div>6</div></div>
  </main>
</body>
</html>
