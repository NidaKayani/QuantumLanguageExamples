<!DOCTYPE html>
<!-- Quantum HTML + CSS example 19_custom_properties/20: Inherited variables -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Inherited variables</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .level { --depth: 0; padding: 0.75rem 0.75rem 0.75rem 1.25rem; border-left: 4px solid hsl(calc(200 + var(--depth) * 40) 70% 50%); background: #fff; border-radius: 8px; }
    .level .level { --depth: 1; margin-top: 0.5rem; }
    .level .level .level { --depth: 2; }
    .level .level .level .level { --depth: 3; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Inherited variables</h1>
    <p class="lead">Custom properties inherit, so children read their ancestors' values.</p>
    <div class="level">Depth 0
      <div class="level">Depth 1
        <div class="level">Depth 2
          <div class="level">Depth 3</div>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
