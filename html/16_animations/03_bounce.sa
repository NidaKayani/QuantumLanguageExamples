<!DOCTYPE html>
<!-- Quantum HTML + CSS example 16_animations/03: Bounce -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Bounce</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .floor { height: 14rem; display: flex; align-items: flex-end; justify-content: center; border-bottom: 4px solid #334155; }
    .ball { width: 3rem; height: 3rem; border-radius: 50%; background: radial-gradient(circle at 30% 30%, #fde68a, #f59e0b); animation: bounce 1s cubic-bezier(0.5, 0.05, 1, 0.5) infinite alternate; }
    @keyframes bounce { from { transform: translateY(-10rem); } to { transform: translateY(0); } }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: 0.01ms; animation-iteration-count: 1; } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Bounce</h1>
    <p class="lead">A ball dropping and bouncing with eased keyframes.</p>
    <div class="floor"><div class="ball"></div></div>
  </main>
</body>
</html>
