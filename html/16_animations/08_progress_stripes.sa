<!DOCTYPE html>
<!-- Quantum HTML + CSS example 16_animations/08: Progress stripes -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Progress stripes</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .bar { height: 1.5rem; background: #e2e8f0; border-radius: 999px; overflow: hidden; }
    .fill { width: 68%; height: 100%; background: repeating-linear-gradient(45deg, #22c55e 0 1rem, #16a34a 1rem 2rem); background-size: 2.83rem 100%; animation: stripes 1s linear infinite; }
    @keyframes stripes { to { background-position: 2.83rem 0; } }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: 0.01ms; animation-iteration-count: 1; } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Progress stripes</h1>
    <p class="lead">Diagonal stripes that scroll inside a progress bar.</p>
    <div class="bar" role="progressbar" aria-valuenow="68" aria-valuemin="0" aria-valuemax="100"><div class="fill"></div></div>
  </main>
</body>
</html>
