<!DOCTYPE html>
<!-- Quantum HTML + CSS example 16_animations/20: Floating animation -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Floating animation</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .cloud { width: 12rem; height: 5rem; border-radius: 999px; background: #fff; box-shadow: 0 16px 30px rgb(0 0 0 / 0.08); animation: float 4s ease-in-out infinite; margin: 3rem auto; }
    @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-1.25rem); } }
    .sky { background: linear-gradient(#bae6fd, #e0f2fe); border-radius: 20px; padding: 1rem; }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: 0.01ms; animation-iteration-count: 1; } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Floating animation</h1>
    <p class="lead">Gentle up-and-down motion for a hero illustration.</p>
    <div class="sky"><div class="cloud" role="img" aria-label="A cloud"></div></div>
  </main>
</body>
</html>
