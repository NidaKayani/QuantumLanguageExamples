<!DOCTYPE html>
<!-- Quantum HTML + CSS example 16_animations/12: Colour cycle -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Colour cycle</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .logo { width: 8rem; height: 8rem; border-radius: 24px; background: linear-gradient(135deg, #ef4444, #f59e0b); animation: hue 6s linear infinite; }
    @keyframes hue { to { filter: hue-rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: 0.01ms; animation-iteration-count: 1; } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Colour cycle</h1>
    <p class="lead">Hue rotation cycling a logo through the rainbow.</p>
    <div class="logo" role="img" aria-label="Logo"></div>
  </main>
</body>
</html>
