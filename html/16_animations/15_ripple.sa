<!DOCTYPE html>
<!-- Quantum HTML + CSS example 16_animations/15: Ripple -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Ripple</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .ripple { position: relative; width: 12rem; height: 12rem; display: grid; place-items: center; }
    .ripple span { position: absolute; width: 3rem; height: 3rem; border: 3px solid #0ea5e9; border-radius: 50%; animation: ring 2.4s ease-out infinite; }
    .ripple span:nth-child(2) { animation-delay: 0.8s; }
    .ripple span:nth-child(3) { animation-delay: 1.6s; }
    @keyframes ring { from { transform: scale(0.5); opacity: 1; } to { transform: scale(4); opacity: 0; } }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: 0.01ms; animation-iteration-count: 1; } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Ripple</h1>
    <p class="lead">Expanding rings from a centre point.</p>
    <div class="ripple"><span></span><span></span><span></span></div>
  </main>
</body>
</html>
