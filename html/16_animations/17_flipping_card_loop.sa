<!DOCTYPE html>
<!-- Quantum HTML + CSS example 16_animations/17: Flipping card loop -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Flipping card loop</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .scene { perspective: 800px; }
    .card { width: 12rem; height: 8rem; border-radius: 14px; background: linear-gradient(135deg, #14b8a6, #0f766e); animation: flip 3s ease-in-out infinite; transform-style: preserve-3d; }
    @keyframes flip { 0%, 20% { transform: rotateY(0); } 50%, 70% { transform: rotateY(180deg); } 100% { transform: rotateY(360deg); } }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: 0.01ms; animation-iteration-count: 1; } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Flipping card loop</h1>
    <p class="lead">A card that keeps turning over in 3D.</p>
    <div class="scene"><div class="card"></div></div>
  </main>
</body>
</html>
