<!DOCTYPE html>
<!-- Quantum HTML + CSS example 16_animations/02: Pulse -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pulse</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .live { position: relative; width: 1rem; height: 1rem; margin: 2rem; border-radius: 50%; background: #ef4444; }
    .live::after { content: ""; position: absolute; inset: 0; border-radius: 50%; background: #ef4444; animation: pulse 1.6s ease-out infinite; }
    @keyframes pulse { from { transform: scale(1); opacity: 0.8; } to { transform: scale(3); opacity: 0; } }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: 0.01ms; animation-iteration-count: 1; } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Pulse</h1>
    <p class="lead">A dot that grows and fades like a heartbeat monitor.</p>
    <p style="display: flex; align-items: center"><span class="live" role="img" aria-label="Live"></span> On air</p>
  </main>
</body>
</html>
