<!DOCTYPE html>
<!-- Quantum HTML + CSS example 16_animations/05: Slide in from the side -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Slide in from the side</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .toast { margin-left: auto; width: 20rem; padding: 1rem 1.25rem; background: #0f172a; color: #fff; border-radius: 12px; animation: slide 0.5s ease-out; }
    @keyframes slide { from { transform: translateX(120%); } to { transform: translateX(0); } }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: 0.01ms; animation-iteration-count: 1; } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Slide in from the side</h1>
    <p class="lead">A notification panel sliding in from the right.</p>
    <div class="toast" role="status">Your changes were saved.</div>
  </main>
</body>
</html>
