<!DOCTYPE html>
<!-- Quantum HTML + CSS example 16_animations/06: Shake -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Shake</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .bad { padding: 0.7rem 1rem; border: 2px solid #dc2626; border-radius: 8px; font: inherit; animation: shake 0.5s ease-in-out 3; }
    @keyframes shake { 0%, 100% { transform: translateX(0); } 20%, 60% { transform: translateX(-8px); } 40%, 80% { transform: translateX(8px); } }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: 0.01ms; animation-iteration-count: 1; } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Shake</h1>
    <p class="lead">A shake for a field with a wrong answer.</p>
    <form action="#"><input class="bad" aria-label="Password" value="wrong password" aria-invalid="true"></form>
  </main>
</body>
</html>
