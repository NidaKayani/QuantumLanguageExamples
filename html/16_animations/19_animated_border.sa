<!DOCTYPE html>
<!-- Quantum HTML + CSS example 16_animations/19: Animated border -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Animated border</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    @property --angle { syntax: "<angle>"; inherits: false; initial-value: 0deg; }
    .glow { width: 20rem; padding: 3px; border-radius: 16px; background: conic-gradient(from var(--angle), #22d3ee, #a855f7, #f43f5e, #22d3ee); animation: rotate 4s linear infinite; }
    .glow div { background: #0f172a; color: #fff; border-radius: 13px; padding: 1.5rem; }
    @keyframes rotate { to { --angle: 360deg; } }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: 0.01ms; animation-iteration-count: 1; } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Animated border</h1>
    <p class="lead">A conic gradient spinning behind a card's edge.</p>
    <div class="glow"><div>A registered custom property animates the gradient angle.</div></div>
  </main>
</body>
</html>
