<!DOCTYPE html>
<!-- Quantum HTML + CSS example 16_animations/10: Heartbeat -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Heartbeat</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .heart { font-size: 5rem; color: #e11d48; display: inline-block; animation: beat 1.2s ease-in-out infinite; }
    @keyframes beat { 0%, 40%, 100% { transform: scale(1); } 10%, 30% { transform: scale(1.2); } 20% { transform: scale(1.05); } }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: 0.01ms; animation-iteration-count: 1; } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Heartbeat</h1>
    <p class="lead">A heart that beats twice, then rests.</p>
    <span class="heart" role="img" aria-label="Heart">&hearts;</span>
  </main>
</body>
</html>
