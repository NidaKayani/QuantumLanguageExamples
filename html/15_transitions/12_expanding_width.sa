<!DOCTYPE html>
<!-- Quantum HTML + CSS example 15_transitions/12: Expanding width -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Expanding width</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .search { width: 10rem; padding: 0.6rem 1rem; border: 2px solid #cbd5e1; border-radius: 999px; font: inherit; transition: width 0.35s ease, border-color 0.35s; }
    .search:focus { width: 22rem; border-color: #0ea5e9; outline: none; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Expanding width</h1>
    <p class="lead">A search box that widens when focused.</p>
    <input class="search" type="search" aria-label="Search" placeholder="Search&hellip;">
  </main>
</body>
</html>
