<!DOCTYPE html>
<!-- Quantum HTML + CSS example 15_transitions/17: Focus ring transition -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Focus ring transition</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .field { display: block; width: 20rem; margin: 0.6rem 0; padding: 0.7rem 1rem; border: 1px solid #cbd5e1; border-radius: 10px; font: inherit; transition: box-shadow 0.2s, border-color 0.2s; }
    .field:focus { outline: none; border-color: #6366f1; box-shadow: 0 0 0 4px rgb(99 102 241 / 0.25); }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Focus ring transition</h1>
    <p class="lead">A soft glow grows around focused fields.</p>
    <form action="#"><input class="field" aria-label="First name" placeholder="First name"><input class="field" aria-label="Last name" placeholder="Last name"></form>
  </main>
</body>
</html>
