<!DOCTYPE html>
<!-- Quantum HTML + CSS example 15_transitions/15: Delayed transitions -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Delayed transitions</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .row { display: flex; gap: 0.5rem; }
    .row span { width: 3rem; height: 3rem; border-radius: 10px; background: #cbd5e1; transition: background-color 0.3s, transform 0.3s; }
    .row:hover span { background: #f43f5e; transform: translateY(-0.75rem); }
    .row span:nth-child(1) { transition-delay: 0ms; }
    .row span:nth-child(2) { transition-delay: 80ms; }
    .row span:nth-child(3) { transition-delay: 160ms; }
    .row span:nth-child(4) { transition-delay: 240ms; }
    .row span:nth-child(5) { transition-delay: 320ms; }
    .row span:nth-child(6) { transition-delay: 400ms; }
    .row span:nth-child(7) { transition-delay: 480ms; }
    .row span:nth-child(8) { transition-delay: 560ms; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Delayed transitions</h1>
    <p class="lead">transition-delay staggers a row of items.</p>
    <div class="row"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
  </main>
</body>
</html>
