<!DOCTYPE html>
<!-- Quantum HTML + CSS example 15_transitions/19: Pressed button -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pressed button</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .btn { display: inline-block; padding: 0.8rem 1.6rem; border: 0; border-radius: 10px; font: inherit; font-weight: 700; cursor: pointer; }
    .btn { background: #16a34a; color: #fff; box-shadow: 0 5px 0 #14532d; transition: transform 0.08s, box-shadow 0.08s; }
    .btn:active { transform: translateY(4px); box-shadow: 0 1px 0 #14532d; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Pressed button</h1>
    <p class="lead">:active shrinks the button and darkens its shadow for a tactile click.</p>
    <button class="btn" type="button">Press me</button>
  </main>
</body>
</html>
