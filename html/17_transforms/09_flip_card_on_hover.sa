<!DOCTYPE html>
<!-- Quantum HTML + CSS example 17_transforms/09: Flip card on hover -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Flip card on hover</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .card { width: 16rem; height: 10rem; perspective: 900px; }
    .inner { position: relative; width: 100%; height: 100%; transition: transform 0.6s; transform-style: preserve-3d; }
    .card:hover .inner, .card:focus-within .inner { transform: rotateY(180deg); }
    .face { position: absolute; inset: 0; display: grid; place-items: center; border-radius: 14px; backface-visibility: hidden; color: #fff; font-weight: 800; font-size: 1.3rem; }
    .front { background: linear-gradient(135deg, #2563eb, #7c3aed); }
    .back { background: linear-gradient(135deg, #db2777, #f97316); transform: rotateY(180deg); }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Flip card on hover</h1>
    <p class="lead">A card with a front and back that turns over.</p>
    <div class="card" tabindex="0"><div class="inner"><div class="face front">Front</div><div class="face back">Back</div></div></div>
  </main>
</body>
</html>
