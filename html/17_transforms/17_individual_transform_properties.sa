<!DOCTYPE html>
<!-- Quantum HTML + CSS example 17_transforms/17: Individual transform properties -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Individual transform properties</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .row { display: flex; flex-wrap: wrap; gap: 2.5rem; padding: 2rem; background: #fff; border-radius: 14px; }
    .row div { width: 6rem; height: 6rem; display: grid; place-items: center; border-radius: 10px; background: #a78bfa; color: #fff; font-size: 0.75rem; font-weight: 700; text-align: center; }
    .ind { translate: 1rem 0; rotate: 20deg; scale: 1.15; }
    .ind:hover { rotate: -20deg; }
    .ind { transition: rotate 0.3s; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Individual transform properties</h1>
    <p class="lead">translate, rotate and scale as separate properties.</p>
    <div class="row"><div>plain</div><div class="ind">translate, rotate, scale</div></div>
  </main>
</body>
</html>
