<!DOCTYPE html>
<!-- Quantum HTML + CSS example 17_transforms/20: Matrix transform -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Matrix transform</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .row { display: flex; flex-wrap: wrap; gap: 2.5rem; padding: 2rem; background: #fff; border-radius: 14px; }
    .row div { width: 6rem; height: 6rem; display: grid; place-items: center; border-radius: 10px; background: #a78bfa; color: #fff; font-size: 0.75rem; font-weight: 700; text-align: center; }
    .mx1 { transform: matrix(1, 0.3, 0, 1, 0, 0); }
    .mx2 { transform: matrix(0.8, 0, 0, 0.8, 20, 10); }
    .mx3 { transform: matrix(0.87, 0.5, -0.5, 0.87, 0, 0); }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Matrix transform</h1>
    <p class="lead">matrix() packs scale, skew and translate into six numbers.</p>
    <div class="row"><div class="mx1">skewY</div><div class="mx2">scale + move</div><div class="mx3">rotate 30deg</div></div>
  </main>
</body>
</html>
