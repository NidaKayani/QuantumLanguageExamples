<!DOCTYPE html>
<!-- Quantum HTML + CSS example 17_transforms/15: Diamond grid -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Diamond grid</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .diamonds { display: flex; gap: 2.5rem; padding: 2rem; }
    .diamonds div { width: 5rem; height: 5rem; display: grid; place-items: center; background: #f472b6; transform: rotate(45deg); border-radius: 10px; }
    .diamonds span { transform: rotate(-45deg); color: #fff; font-weight: 800; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Diamond grid</h1>
    <p class="lead">Squares turned 45 degrees with text turned back upright.</p>
    <div class="diamonds"><div><span>A</span></div><div><span>B</span></div><div><span>C</span></div></div>
  </main>
</body>
</html>
