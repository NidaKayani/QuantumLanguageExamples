<!DOCTYPE html>
<!-- Quantum HTML + CSS example 17_transforms/19: Parallelogram buttons -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Parallelogram buttons</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .tabs { display: flex; gap: 0.3rem; }
    .tabs a { display: inline-block; padding: 0.7rem 1.5rem; background: #0f766e; color: #fff; text-decoration: none; transform: skewX(-18deg); }
    .tabs a span { display: inline-block; transform: skewX(18deg); }
    .tabs a:hover { background: #115e59; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Parallelogram buttons</h1>
    <p class="lead">skew on the button, the opposite skew on its label.</p>
    <nav class="tabs" aria-label="Demo"><a href="#1"><span>Overview</span></a><a href="#2"><span>Specs</span></a><a href="#3"><span>Reviews</span></a></nav>
  </main>
</body>
</html>
