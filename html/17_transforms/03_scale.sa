<!DOCTYPE html>
<!-- Quantum HTML + CSS example 17_transforms/03: scale -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>scale</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .row { display: flex; flex-wrap: wrap; gap: 2.5rem; padding: 2rem; background: #fff; border-radius: 14px; }
    .row div { width: 6rem; height: 6rem; display: grid; place-items: center; border-radius: 10px; background: #a78bfa; color: #fff; font-size: 0.75rem; font-weight: 700; text-align: center; }
    .s1 { transform: scale(0.6); } .s2 { transform: scale(1.3); } .s3 { transform: scaleX(1.6); } .s4 { transform: scaleY(0.5); }
  </style>
</head>
<body>
  <main class="demo">
    <h1>scale</h1>
    <p class="lead">Shrinking, growing and stretching.</p>
    <div class="row"><div class="s1">0.6</div><div class="s2">1.3</div><div class="s3">X 1.6</div><div class="s4">Y 0.5</div></div>
  </main>
</body>
</html>
