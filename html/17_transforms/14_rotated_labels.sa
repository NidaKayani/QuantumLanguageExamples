<!DOCTYPE html>
<!-- Quantum HTML + CSS example 17_transforms/14: Rotated labels -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Rotated labels</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .chart { display: flex; gap: 0.75rem; align-items: flex-end; height: 14rem; padding-bottom: 5rem; }
    .chart div { width: 2.2rem; background: #38bdf8; border-radius: 6px 6px 0 0; position: relative; }
    .chart span { position: absolute; top: calc(100% + 0.6rem); left: 50%; white-space: nowrap; transform: rotate(-60deg); transform-origin: left top; font-size: 0.85rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Rotated labels</h1>
    <p class="lead">Vertical column headers from rotate(-90deg).</p>
    <div class="chart">
      <div style="height: 40%"><span>January</span></div><div style="height: 70%"><span>February</span></div>
      <div style="height: 55%"><span>March</span></div><div style="height: 90%"><span>April</span></div>
    </div>
  </main>
</body>
</html>
