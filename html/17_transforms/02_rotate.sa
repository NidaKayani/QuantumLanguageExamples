<!DOCTYPE html>
<!-- Quantum HTML + CSS example 17_transforms/02: rotate -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>rotate</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .row { display: flex; flex-wrap: wrap; gap: 2.5rem; padding: 2rem; background: #fff; border-radius: 14px; }
    .row div { width: 6rem; height: 6rem; display: grid; place-items: center; border-radius: 10px; background: #a78bfa; color: #fff; font-size: 0.75rem; font-weight: 700; text-align: center; }
    .r0 { transform: rotate(15deg); }
    .r1 { transform: rotate(45deg); }
    .r2 { transform: rotate(90deg); }
    .r3 { transform: rotate(135deg); }
    .r4 { transform: rotate(180deg); }
    .r5 { transform: rotate(-30deg); }
  </style>
</head>
<body>
  <main class="demo">
    <h1>rotate</h1>
    <p class="lead">The same box at six angles.</p>
    <div class="row"><div class="r0">15deg</div><div class="r1">45deg</div><div class="r2">90deg</div><div class="r3">135deg</div><div class="r4">180deg</div><div class="r5">-30deg</div></div>
  </main>
</body>
</html>
