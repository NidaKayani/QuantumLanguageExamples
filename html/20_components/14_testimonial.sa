<!DOCTYPE html>
<!-- Quantum HTML + CSS example 20_components/14: Testimonial -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Testimonial</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .testimonial { max-width: 34rem; padding: 2rem; border-radius: 20px; background: #fff; box-shadow: 0 10px 30px rgb(0 0 0 / 0.08); }
    .testimonial blockquote { margin: 0 0 1.25rem; font-size: 1.2rem; }
    .testimonial figcaption { display: flex; gap: 0.75rem; align-items: center; }
    .testimonial img { width: 3rem; height: 3rem; border-radius: 50%; }
    .testimonial cite { font-style: normal; font-weight: 700; display: block; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Testimonial</h1>
    <p class="lead">A quote with a photo and a name.</p>
    <figure class="testimonial">
      <blockquote><p>&ldquo;We rebuilt our whole site in a weekend. The compiler caught every typo in our CSS.&rdquo;</p></blockquote>
      <figcaption><img src="https://picsum.photos/seed/face2/96/96" alt="Photo of Hamza" width="96" height="96"><span><cite>Hamza Ali</cite>Front-end lead</span></figcaption>
    </figure>
  </main>
</body>
</html>
