<!DOCTYPE html>
<!-- Quantum HTML + CSS example 20_components/11: Stepper -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Stepper</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .stepper { display: flex; gap: 0.5rem; list-style: none; padding: 0; counter-reset: s; }
    .stepper li { flex: 1; counter-increment: s; padding: 0.75rem; border-radius: 10px; background: #f1f5f9; color: #64748b; font-weight: 600; }
    .stepper li::before { content: counter(s) ". "; }
    .stepper .done { background: #dcfce7; color: #166534; }
    .stepper .now { background: #2563eb; color: #fff; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Stepper</h1>
    <p class="lead">Current, completed and upcoming steps.</p>
    <ol class="stepper"><li class="done">Cart</li><li class="done">Details</li><li class="now" aria-current="step">Payment</li><li>Review</li></ol>
  </main>
</body>
</html>
