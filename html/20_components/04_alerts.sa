<!DOCTYPE html>
<!-- Quantum HTML + CSS example 20_components/04: Alerts -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Alerts</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .alert { display: flex; gap: 0.75rem; align-items: flex-start; padding: 0.9rem 1.1rem; margin: 0.75rem 0; border-radius: 12px; border: 1px solid; }
    .alert span { font-weight: 800; }
    .info { background: #eff6ff; color: #1d4ed8; border-color: #1d4ed8; }
    .success { background: #f0fdf4; color: #15803d; border-color: #15803d; }
    .warning { background: #fffbeb; color: #b45309; border-color: #b45309; }
    .error { background: #fef2f2; color: #b91c1c; border-color: #b91c1c; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Alerts</h1>
    <p class="lead">Info, success, warning and error messages.</p>
    <div class="alert info" role="status"><span aria-hidden="true">&#8505;</span><p>A new version is available.</p></div>
    <div class="alert success" role="status"><span aria-hidden="true">&#10003;</span><p>Your profile was updated.</p></div>
    <div class="alert warning" role="status"><span aria-hidden="true">&#9888;</span><p>Your trial ends in 3 days.</p></div>
    <div class="alert error" role="alert"><span aria-hidden="true">&#10007;</span><p>The payment could not be processed.</p></div>
  </main>
</body>
</html>
