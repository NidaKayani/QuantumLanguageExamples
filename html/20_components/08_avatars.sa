<!DOCTYPE html>
<!-- Quantum HTML + CSS example 20_components/08: Avatars -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Avatars</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .people { display: flex; gap: 1rem; align-items: center; }
    .avatar { position: relative; width: 3.5rem; height: 3.5rem; border-radius: 50%; display: grid; place-items: center; font-weight: 800; color: #fff; background: #0ea5e9; }
    .avatar img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
    .avatar::after { content: ""; position: absolute; right: 0; bottom: 0; width: 0.9rem; height: 0.9rem; border-radius: 50%; border: 2px solid #fff; background: var(--status, #22c55e); }
    .away { --status: #f59e0b; } .off { --status: #94a3b8; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Avatars</h1>
    <p class="lead">Initials, images and status dots.</p>
    <div class="people">
      <span class="avatar">QL</span>
      <span class="avatar away"><img src="https://picsum.photos/seed/face1/120/120" alt="Profile photo of Ayesha" width="120" height="120"></span>
      <span class="avatar off" style="background: #a855f7">MZ</span>
    </div>
  </main>
</body>
</html>
