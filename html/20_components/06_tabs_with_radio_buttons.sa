<!DOCTYPE html>
<!-- Quantum HTML + CSS example 20_components/06: Tabs with radio buttons -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Tabs with radio buttons</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .tabs { background: #fff; border-radius: 14px; padding: 1rem; }
    .tabs input { position: absolute; opacity: 0; }
    .tabs label { display: inline-block; padding: 0.5rem 1rem; border-radius: 8px; cursor: pointer; color: #475569; font-weight: 600; }
    .tabs .panel { display: none; padding: 1rem 0.25rem 0; }
    #tab1:checked ~ .p1, #tab2:checked ~ .p2, #tab3:checked ~ .p3 { display: block; }
    #tab1:checked ~ label[for="tab1"], #tab2:checked ~ label[for="tab2"], #tab3:checked ~ label[for="tab3"] { background: #e0e7ff; color: #3730a3; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Tabs with radio buttons</h1>
    <p class="lead">Panels switched by :checked radio inputs.</p>
    <div class="tabs">
      <input type="radio" name="t" id="tab1" checked><input type="radio" name="t" id="tab2"><input type="radio" name="t" id="tab3">
      <label for="tab1">Overview</label><label for="tab2">Features</label><label for="tab3">Pricing</label>
      <div class="panel p1"><p>An overview of the product.</p></div>
      <div class="panel p2"><p>Everything it can do.</p></div>
      <div class="panel p3"><p>Plans from $0.</p></div>
    </div>
  </main>
</body>
</html>
