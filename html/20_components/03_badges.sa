<!DOCTYPE html>
<!-- Quantum HTML + CSS example 20_components/03: Badges -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Badges</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .badges { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .badge { padding: 0.2rem 0.65rem; border-radius: 999px; font-size: 0.8rem; font-weight: 700; }
    .green { background: #dcfce7; color: #166534; } .blue { background: #dbeafe; color: #1e40af; }
    .amber { background: #fef3c7; color: #92400e; } .red { background: #fee2e2; color: #991b1b; } .grey { background: #f1f5f9; color: #334155; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Badges</h1>
    <p class="lead">Small status labels in several colours.</p>
    <div class="badges"><span class="badge green">Active</span><span class="badge blue">New</span><span class="badge amber">Pending</span><span class="badge red">Failed</span><span class="badge grey">Archived</span></div>
  </main>
</body>
</html>
