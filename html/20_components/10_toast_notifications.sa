<!DOCTYPE html>
<!-- Quantum HTML + CSS example 20_components/10: Toast notifications -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Toast notifications</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .toasts { position: fixed; right: 1rem; bottom: 1rem; display: flex; flex-direction: column; gap: 0.5rem; width: 20rem; }
    .toast { display: flex; justify-content: space-between; gap: 1rem; padding: 0.9rem 1rem; border-radius: 12px; background: #0f172a; color: #f8fafc; box-shadow: 0 8px 20px rgb(0 0 0 / 0.25); }
    .toast.ok { border-left: 5px solid #22c55e; } .toast.err { border-left: 5px solid #ef4444; }
    .toast button { border: 0; background: none; color: #94a3b8; cursor: pointer; font-size: 1.1rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Toast notifications</h1>
    <p class="lead">Stacked messages in the corner.</p>
    <div class="toasts" role="status">
      <div class="toast ok"><span>File uploaded.</span><button type="button" aria-label="Dismiss">&times;</button></div>
      <div class="toast err"><span>Could not connect.</span><button type="button" aria-label="Dismiss">&times;</button></div>
    </div>
  </main>
</body>
</html>
