<!DOCTYPE html>
<!-- Quantum HTML + CSS example 20_components/09: Chips -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Chips</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; }
    .chips li { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.5rem 0.35rem 0.9rem; border-radius: 999px; background: #e0f2fe; color: #075985; }
    .chips button { width: 1.4rem; height: 1.4rem; border: 0; border-radius: 50%; background: #bae6fd; color: #075985; cursor: pointer; line-height: 1; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Chips</h1>
    <p class="lead">Removable filter chips.</p>
    <ul class="chips">
      <li>Under $50 <button type="button" aria-label="Remove Under $50">&times;</button></li>
      <li>In stock <button type="button" aria-label="Remove In stock">&times;</button></li>
      <li>Blue <button type="button" aria-label="Remove Blue">&times;</button></li>
    </ul>
  </main>
</body>
</html>
