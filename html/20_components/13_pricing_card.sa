<!DOCTYPE html>
<!-- Quantum HTML + CSS example 20_components/13: Pricing card -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pricing card</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .plan { width: 20rem; padding: 2rem; border-radius: 20px; background: #0f172a; color: #e2e8f0; }
    .plan h2 { margin: 0; color: #fff; }
    .plan .price { font-size: 3rem; font-weight: 800; color: #fff; margin: 0.5rem 0; }
    .plan .price small { font-size: 1rem; color: #94a3b8; }
    .plan ul { padding: 0; list-style: none; }
    .plan li { padding: 0.4rem 0; }
    .plan li::before { content: "\2713  "; color: #4ade80; font-weight: 800; }
    .plan a { display: block; text-align: center; padding: 0.8rem; border-radius: 12px; background: #4ade80; color: #052e16; font-weight: 800; text-decoration: none; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Pricing card</h1>
    <p class="lead">A highlighted plan with a list of features.</p>
    <article class="plan">
      <h2>Pro</h2>
      <p class="price">$12<small>/month</small></p>
      <ul><li>Unlimited projects</li><li>Custom domains</li><li>Priority support</li></ul>
      <a href="#buy">Start free trial</a>
    </article>
  </main>
</body>
</html>
