<!DOCTYPE html>
<!-- Quantum HTML + CSS example 06_box_model/19: Logical properties -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Logical properties</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .note { margin-inline-start: 2rem; padding-block: 1rem; padding-inline: 1.5rem; border-inline-start: 6px solid #8b5cf6; background: #f5f3ff; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Logical properties</h1>
    <p class="lead">margin-inline and padding-block follow the writing direction.</p>
    <p class="note">Left to right: the border is on the left.</p>
    <p class="note" dir="rtl">Right to left: the same CSS puts the border on the right.</p>
  </main>
</body>
</html>
