<!DOCTYPE html>
<!-- Quantum HTML + CSS example 06_box_model/13: Width, min-width and max-width -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Width, min-width and max-width</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .w { background: #ccfbf1; border-left: 6px solid #0d9488; padding: 0.75rem 1rem; margin: 0.75rem 0; }
    .fixed { width: 20rem; }
    .fluid { width: 60%; }
    .capped { width: 100%; max-width: 30rem; }
    .floor { width: 20%; min-width: 14rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Width, min-width and max-width</h1>
    <p class="lead">Boxes that grow with the window but stay readable.</p>
    <div class="w fixed">width: 20rem</div>
    <div class="w fluid">width: 60%</div>
    <div class="w capped">width: 100%; max-width: 30rem</div>
    <div class="w floor">width: 20%; min-width: 14rem</div>
  </main>
</body>
</html>
