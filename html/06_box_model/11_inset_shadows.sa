<!DOCTYPE html>
<!-- Quantum HTML + CSS example 06_box_model/11: Inset shadows -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Inset shadows</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .wells { display: flex; gap: 1.5rem; }
    .well { width: 10rem; height: 6rem; border-radius: 12px; background: #e2e8f0; box-shadow: inset 0 3px 8px rgb(0 0 0 / 0.25); display: grid; place-items: center; }
    .pressed { background: #c7d2fe; box-shadow: inset 4px 4px 10px #a5b4fc, inset -4px -4px 10px #e0e7ff; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Inset shadows</h1>
    <p class="lead">Inset box-shadow presses an element into the page.</p>
    <div class="wells"><div class="well">inset</div><div class="well pressed">neumorphic</div></div>
  </main>
</body>
</html>
