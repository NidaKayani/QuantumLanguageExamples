<!DOCTYPE html>
<!-- Quantum HTML + CSS example 06_box_model/06: Padding shorthand, four values -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Padding shorthand, four values</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .inner { display: inline-block; background: #fbcfe8; padding: 0.5rem 1rem 2rem 3rem; outline: 2px dashed #db2777; }
    .inner span { display: block; background: #fff; padding: 0.5rem 1rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Padding shorthand, four values</h1>
    <p class="lead">padding: 0.5rem 1rem 2rem 3rem &mdash; top, right, bottom, left in clockwise order.</p>
    <div class="inner"><span>padding: 0.5rem 1rem 2rem 3rem</span></div>
  </main>
</body>
</html>
