<!DOCTYPE html>
<!-- Quantum HTML + CSS example 06_box_model/10: Elevation with shadows -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Elevation with shadows</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .cards { display: flex; gap: 1.5rem; flex-wrap: wrap; }
    .cards div { width: 8rem; height: 8rem; border-radius: 12px; background: #fff; display: grid; place-items: center; font-weight: 700; color: #475569; }
    .e1 { box-shadow: 0 1px 2px rgb(0 0 0 / 0.08); }
    .e2 { box-shadow: 0 2px 6px rgb(0 0 0 / 0.12); }
    .e3 { box-shadow: 0 6px 14px rgb(0 0 0 / 0.14); }
    .e4 { box-shadow: 0 12px 28px rgb(0 0 0 / 0.16); }
    .e5 { box-shadow: 0 24px 48px rgb(0 0 0 / 0.2); }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Elevation with shadows</h1>
    <p class="lead">box-shadow levels from flat to floating.</p>
    <div class="cards">
      <div class="e1">1</div>
      <div class="e2">2</div>
      <div class="e3">3</div>
      <div class="e4">4</div>
      <div class="e5">5</div>
    </div>
  </main>
</body>
</html>
