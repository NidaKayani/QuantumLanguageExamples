<!DOCTYPE html>
<!-- Quantum HTML + CSS example 06_box_model/20: Gradient border -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Gradient border</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .frame { padding: 1.5rem; border: 4px solid transparent; border-radius: 16px;
      background: linear-gradient(#fff, #fff) padding-box, linear-gradient(135deg, #06b6d4, #a855f7, #f43f5e) border-box; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Gradient border</h1>
    <p class="lead">A gradient frame with background-clip and a transparent border.</p>
    <div class="frame"><h2>Gradient border</h2><p>The inner background covers the padding box; the gradient shows through the border.</p></div>
  </main>
</body>
</html>
