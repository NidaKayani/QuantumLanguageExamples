<!DOCTYPE html>
<!-- Quantum HTML + CSS example 06_box_model/12: Multiple borders with box-shadow -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Multiple borders with box-shadow</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .rings { width: 8rem; height: 8rem; margin: 4rem; border-radius: 50%; background: #fef08a;
      box-shadow: 0 0 0 10px #f97316, 0 0 0 20px #ef4444, 0 0 0 30px #a855f7, 0 0 0 40px #3b82f6; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Multiple borders with box-shadow</h1>
    <p class="lead">Stacked spread shadows draw several rings.</p>
    <div class="rings"></div>
  </main>
</body>
</html>
