<!DOCTYPE html>
<!-- Quantum HTML + CSS example 12_positioning/11: Floating action button -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Floating action button</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .fab { position: fixed; right: 1.5rem; bottom: 1.5rem; width: 3.75rem; height: 3.75rem; border: 0; border-radius: 50%; background: #7c3aed; color: #fff; font-size: 2rem; line-height: 1; cursor: pointer; box-shadow: 0 6px 18px rgb(124 58 237 / 0.5); }
    .fab:hover { background: #6d28d9; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Floating action button</h1>
    <p class="lead">A round button fixed in the bottom corner.</p>
    <p>The add button floats over the page.</p>
    <button class="fab" type="button" aria-label="Add">+</button>
  </main>
</body>
</html>
