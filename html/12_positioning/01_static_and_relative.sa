<!DOCTYPE html>
<!-- Quantum HTML + CSS example 12_positioning/01: Static and relative -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Static and relative</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .stage { position: relative; min-height: 14rem; background: #f1f5f9; border: 2px dashed #94a3b8; border-radius: 12px; padding: 1rem; }
    .box { display: inline-block; width: 7rem; height: 5rem; margin: 0.5rem; background: #60a5fa; border-radius: 8px; }
    .moved { position: relative; top: 1.5rem; left: 1.5rem; background: #f472b6; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Static and relative</h1>
    <p class="lead">position: relative nudges a box without moving its neighbours.</p>
    <div class="stage"><div class="box"></div><div class="box moved"></div><div class="box"></div></div>
  </main>
</body>
</html>
