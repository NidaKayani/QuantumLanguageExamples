<!DOCTYPE html>
<!-- Quantum HTML + CSS example 12_positioning/10: Image caption overlay -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Image caption overlay</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    figure { position: relative; margin: 0; width: 20rem; height: 14rem; border-radius: 14px; overflow: hidden; background: linear-gradient(135deg, #f97316, #be123c); }
    figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 1rem; color: #fff; background: rgb(0 0 0 / 0.55); transform: translateY(100%); transition: transform 0.3s ease; }
    figure:hover figcaption, figure:focus-within figcaption { transform: translateY(0); }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Image caption overlay</h1>
    <p class="lead">A caption that slides up over its picture on hover.</p>
    <figure tabindex="0"><figcaption>Desert dunes at dusk</figcaption></figure>
  </main>
</body>
</html>
