<!DOCTYPE html>
<!-- Quantum HTML + CSS example 12_positioning/03: Fixed toolbar -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Fixed toolbar</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .toolbar { position: fixed; left: 50%; bottom: 1rem; transform: translateX(-50%); display: flex; gap: 0.5rem; padding: 0.5rem; background: #0f172a; border-radius: 999px; box-shadow: 0 8px 24px rgb(0 0 0 / 0.3); }
    .toolbar button { border: 0; border-radius: 999px; padding: 0.5rem 1rem; background: #1e293b; color: #fff; font: inherit; cursor: pointer; }
    .long { height: 140vh; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Fixed toolbar</h1>
    <p class="lead">position: fixed pins a bar to the viewport.</p>
    <div class="long"><p>Scroll: the toolbar stays at the bottom of the window.</p></div>
    <div class="toolbar"><button type="button">Bold</button><button type="button">Italic</button><button type="button">Link</button></div>
  </main>
</body>
</html>
