<!DOCTYPE html>
<!-- Quantum HTML + CSS example 12_positioning/08: Centred overlay -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Centred overlay</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .photo { position: relative; height: 18rem; border-radius: 16px; background: linear-gradient(135deg, #0ea5e9, #14b8a6); }
    .overlay { position: absolute; inset: 0; margin: auto; width: 16rem; height: 6rem; display: grid; place-items: center; background: rgb(255 255 255 / 0.9); border-radius: 12px; font-weight: 700; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Centred overlay</h1>
    <p class="lead">inset: 0 and auto margins centre a box over its container.</p>
    <div class="photo"><div class="overlay">Centred with inset: 0</div></div>
  </main>
</body>
</html>
