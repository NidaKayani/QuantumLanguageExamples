<!DOCTYPE html>
<!-- Quantum HTML + CSS example 12_positioning/16: Hero with overlay text -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Hero with overlay text</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .hero { position: relative; height: 20rem; border-radius: 20px; overflow: hidden; background: linear-gradient(120deg, #1e3a8a, #6d28d9 60%, #db2777); }
    .hero::before { content: ""; position: absolute; inset: 0; background: radial-gradient(circle at 80% 20%, rgb(255 255 255 / 0.25), transparent 40%); }
    .hero div { position: absolute; left: 2rem; bottom: 2rem; color: #fff; max-width: 26rem; }
    .hero h2 { font-size: 2.2rem; margin: 0 0 0.5rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Hero with overlay text</h1>
    <p class="lead">Text positioned over a full-width banner.</p>
    <section class="hero"><div><h2>Build for the web</h2><p>HTML for structure, CSS for style, Quantum to compile them.</p></div></section>
  </main>
</body>
</html>
