<!DOCTYPE html>
<!-- Quantum HTML + CSS example 13_selectors/19: Form state pseudo-classes -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Form state pseudo-classes</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .f label { display: flex; gap: 0.5rem; align-items: center; margin: 0.5rem 0; }
    .f input:required { border-left: 4px solid #f59e0b; }
    .f input:disabled { background: #f1f5f9; cursor: not-allowed; }
    .f input:checked + span { color: #16a34a; font-weight: 700; }
    .f input:focus-visible { outline: 3px solid #6366f1; }
    .f input[type="text"] { padding: 0.4rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Form state pseudo-classes</h1>
    <p class="lead">:checked, :disabled, :required and :focus-visible.</p>
    <form class="f" action="#">
      <label><input type="text" required placeholder="Required"></label>
      <label><input type="text" disabled value="Disabled"></label>
      <label><input type="checkbox" checked><span>Checked turns green</span></label>
    </form>
  </main>
</body>
</html>
