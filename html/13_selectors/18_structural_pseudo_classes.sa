<!DOCTYPE html>
<!-- Quantum HTML + CSS example 13_selectors/18: Structural pseudo-classes -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Structural pseudo-classes</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .boxes { display: flex; gap: 0.5rem; margin-bottom: 1rem; }
    .boxes span { min-width: 4rem; min-height: 3rem; padding: 0.5rem; background: #e2e8f0; border-radius: 8px; }
    .boxes span:first-child { background: #22c55e; }
    .boxes span:last-child { background: #3b82f6; color: #fff; }
    .boxes span:only-child { background: #f59e0b; }
    .boxes span:empty { background: repeating-linear-gradient(45deg, #fecaca 0 6px, #fff 6px 12px); }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Structural pseudo-classes</h1>
    <p class="lead">:first-child, :last-child, :only-child and :empty.</p>
    <div class="boxes"><span>first</span><span>middle</span><span></span><span>last</span></div>
    <div class="boxes"><span>only child</span></div>
  </main>
</body>
</html>
