<!DOCTYPE html>
<!-- Quantum HTML + CSS example 13_selectors/08: Attribute selector [data-kind] -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Attribute selector [data-kind]</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .links a { display: block; padding: 0.5rem 0.75rem; margin: 0.3rem 0; border-radius: 8px; background: #fff; color: #0f172a; text-decoration: none; border-left: 6px solid #cbd5e1; }
    .links a[data-kind] { border-left-color: #16a34a; background: #dcfce7; font-weight: 700; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Attribute selector [data-kind]</h1>
    <p class="lead">a[data-kind]: the attribute has the attribute at all.</p>
    <nav class="links" aria-label="Files">
      <a href="https://example.com/report.pdf">Annual report (https, .pdf)</a>
      <a href="http://example.org/photo.jpg" lang="en-GB">Photo (http, .jpg, lang en-GB)</a>
      <a href="/docs/guide.html" class="nav primary">Guide (relative, classes nav primary)</a>
      <a href="mailto:team@example.com" data-kind="email">Email us (mailto, data-kind)</a>
    </nav>
  </main>
</body>
</html>
