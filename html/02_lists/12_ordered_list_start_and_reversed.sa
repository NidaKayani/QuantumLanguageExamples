<!DOCTYPE html>
<!-- Quantum HTML + CSS example 02_lists/12: Ordered list start and reversed -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Ordered list start and reversed</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .card { background: #fff; border-radius: 12px; padding: 1.5rem; box-shadow: 0 1px 3px rgb(0 0 0 / 0.12); }
    .card li { margin: 0.25rem 0; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Ordered list start and reversed</h1>
    <p class="lead">start, reversed and value change the numbering.</p>
    <section class="card">
      <h2>Countdown</h2>
      <ol reversed>
        <li>Three</li>
        <li>Two</li>
        <li>One</li>
      </ol>
      <h2>Chapters 7 onward</h2>
      <ol start="7">
        <li>Grids</li>
        <li>Animations</li>
        <li value="12">Appendix</li>
      </ol>
    </section>
  </main>
</body>
</html>
