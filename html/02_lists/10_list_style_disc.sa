<!DOCTYPE html>
<!-- Quantum HTML + CSS example 02_lists/10: List style disc -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>List style disc</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .card { background: #fff; border-radius: 12px; padding: 1.5rem; box-shadow: 0 1px 3px rgb(0 0 0 / 0.12); }
    .card li { margin: 0.25rem 0; }
    .card ul { list-style-type: disc; padding-left: 2.5rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>List style disc</h1>
    <p class="lead">list-style-type: disc. Filled disc bullets.</p>
    <section class="card">
      <ul>
        <li>Plan the page</li>
        <li>Write the markup</li>
        <li>Add the styles</li>
        <li>Test in browsers</li>
      </ul>
    </section>
  </main>
</body>
</html>
