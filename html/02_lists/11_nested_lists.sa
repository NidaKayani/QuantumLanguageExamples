<!DOCTYPE html>
<!-- Quantum HTML + CSS example 02_lists/11: Nested lists -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Nested lists</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .card { background: #fff; border-radius: 12px; padding: 1.5rem; box-shadow: 0 1px 3px rgb(0 0 0 / 0.12); }
    .card li { margin: 0.25rem 0; }
    .card ul ul { list-style-type: circle; }
    .card ul ul ul { list-style-type: square; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Nested lists</h1>
    <p class="lead">Lists inside list items make an outline.</p>
    <section class="card">
      <ul>
        <li>Front end
          <ul>
            <li>HTML</li>
            <li>CSS
              <ul>
                <li>Flexbox</li>
                <li>Grid</li>
              </ul>
            </li>
          </ul>
        </li>
        <li>Back end</li>
      </ul>
    </section>
  </main>
</body>
</html>
