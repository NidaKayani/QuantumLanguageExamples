<!DOCTYPE html>
<!-- Quantum HTML + CSS example 02_lists/17: Inline list -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Inline list</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .card { background: #fff; border-radius: 12px; padding: 1.5rem; box-shadow: 0 1px 3px rgb(0 0 0 / 0.12); }
    .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 0; }
    .tags li { background: #e0e7ff; color: #3730a3; padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.9rem; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Inline list</h1>
    <p class="lead">A horizontal list for tags and keywords.</p>
    <section class="card">
      <ul class="tags">
        <li>html</li><li>css</li><li>layout</li><li>flexbox</li><li>grid</li><li>a11y</li>
      </ul>
    </section>
  </main>
</body>
</html>
