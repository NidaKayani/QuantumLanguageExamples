<!DOCTYPE html>
<!-- Quantum HTML + CSS example 02_lists/18: Two-column list -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Two-column list</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .card { background: #fff; border-radius: 12px; padding: 1.5rem; box-shadow: 0 1px 3px rgb(0 0 0 / 0.12); }
    .card li { margin: 0.25rem 0; }
    .card ul { columns: 2; column-gap: 2rem; }
    .card li { break-inside: avoid; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Two-column list</h1>
    <p class="lead">columns flows a long list into two columns.</p>
    <section class="card">
      <ul>
        <li>Apples</li><li>Bananas</li><li>Cherries</li><li>Dates</li><li>Elderberries</li>
        <li>Figs</li><li>Grapes</li><li>Honeydew</li><li>Kiwis</li><li>Lemons</li>
      </ul>
    </section>
  </main>
</body>
</html>
