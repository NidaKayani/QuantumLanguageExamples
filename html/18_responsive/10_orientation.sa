<!DOCTYPE html>
<!-- Quantum HTML + CSS example 18_responsive/10: Orientation -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Orientation</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .split { display: flex; flex-direction: column; gap: 1rem; }
    .split div { padding: 2rem; border-radius: 12px; background: #a7f3d0; text-align: center; font-weight: 700; }
    @media (orientation: landscape) { .split { flex-direction: row; } .split div { flex: 1; background: #bfdbfe; } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Orientation</h1>
    <p class="lead">Different layouts for portrait and landscape.</p>
    <div class="split"><div>Panel A</div><div>Panel B</div></div>
  </main>
</body>
</html>
