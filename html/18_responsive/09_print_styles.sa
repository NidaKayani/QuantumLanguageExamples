<!DOCTYPE html>
<!-- Quantum HTML + CSS example 18_responsive/09: Print styles -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Print styles</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .toolbar { display: flex; gap: 0.5rem; margin-bottom: 1rem; }
    .toolbar a { padding: 0.4rem 0.8rem; background: #e2e8f0; border-radius: 6px; color: #0f172a; text-decoration: none; }
    @media print {
      .toolbar { display: none; }
      body { background: #fff; }
      a[href^="http"]::after { content: " (" attr(href) ")"; font-size: 0.9em; }
    }
    @page { margin: 2cm; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Print styles</h1>
    <p class="lead">@media print hides navigation and shows link addresses.</p>
    <nav class="toolbar" aria-label="Actions"><a href="#share">Share</a><a href="#save">Save</a></nav>
    <article><h2>Printable article</h2><p>Read more at <a href="https://developer.mozilla.org/">MDN</a>. Print this page to see the address appear.</p></article>
  </main>
</body>
</html>
