<!DOCTYPE html>
<!-- Quantum HTML + CSS example 18_responsive/19: Show and hide by breakpoint -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Show and hide by breakpoint</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .mobile-only { display: block; } .desktop-only { display: none; }
    @media (min-width: 48rem) { .mobile-only { display: none; } .desktop-only { display: block; } }
    .mobile-only, .desktop-only { padding: 1rem; border-radius: 10px; background: #fef3c7; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Show and hide by breakpoint</h1>
    <p class="lead">Different content for small and large screens.</p>
    <p class="mobile-only">You are on a small screen: tap to call us.</p><p class="desktop-only">You are on a large screen: email us at hello@example.com.</p>
  </main>
</body>
</html>
