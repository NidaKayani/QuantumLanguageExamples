<!DOCTYPE html>
<!-- Quantum HTML + CSS example 18_responsive/11: min() and max() widths -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>min() and max() widths</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .box { margin: 0.75rem 0; padding: 1rem; border-radius: 10px; background: #fbcfe8; }
    .a { width: min(100%, 30rem); }
    .b { width: max(50%, 16rem); }
    .c { padding-inline: max(1rem, 5vw); }
  </style>
</head>
<body>
  <main class="demo">
    <h1>min() and max() widths</h1>
    <p class="lead">Sizes that pick the smaller or larger of two values.</p>
    <div class="box a">width: min(100%, 30rem)</div>
    <div class="box b">width: max(50%, 16rem)</div>
    <div class="box c">padding-inline: max(1rem, 5vw)</div>
  </main>
</body>
</html>
