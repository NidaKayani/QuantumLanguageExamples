<!DOCTYPE html>
<!-- Quantum HTML + CSS example 18_responsive/02: Mobile-first navigation -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mobile-first navigation</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .nav { display: flex; flex-direction: column; gap: 0.25rem; background: #0f172a; padding: 0.5rem; border-radius: 12px; }
    .nav a { color: #e2e8f0; text-decoration: none; padding: 0.6rem 0.8rem; border-radius: 8px; }
    .nav a:hover { background: #1e293b; }
    @media (min-width: 40rem) { .nav { flex-direction: row; } .nav a:first-child { margin-right: auto; font-weight: 800; } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Mobile-first navigation</h1>
    <p class="lead">Links stack on phones and line up on wider screens.</p>
    <nav class="nav" aria-label="Main"><a href="#home">Quantum</a><a href="#docs">Docs</a><a href="#blog">Blog</a><a href="#about">About</a></nav>
  </main>
</body>
</html>
