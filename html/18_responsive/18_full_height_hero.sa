<!DOCTYPE html>
<!-- Quantum HTML + CSS example 18_responsive/18: Full-height hero -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Full-height hero</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .hero { min-height: 70dvh; display: grid; place-items: center; text-align: center; border-radius: 20px; color: #fff; background: linear-gradient(160deg, #0f172a, #1e3a8a); padding: 2rem; }
    .hero h2 { font-size: clamp(2rem, 6vw, 4rem); margin: 0; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Full-height hero</h1>
    <p class="lead">dvh units fit the visible viewport on mobile browsers.</p>
    <section class="hero"><div><h2>Hello, viewport</h2><p>70dvh tall on every phone.</p></div></section>
  </main>
</body>
</html>
