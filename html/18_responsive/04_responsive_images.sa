<!DOCTYPE html>
<!-- Quantum HTML + CSS example 18_responsive/04: Responsive images -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Responsive images</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    picture img, .dense { display: block; width: 100%; max-width: 40rem; height: auto; border-radius: 14px; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Responsive images</h1>
    <p class="lead">picture chooses a source by screen size; srcset by density.</p>
    <picture>
      <source media="(min-width: 64rem)" srcset="https://picsum.photos/seed/wide/1200/500">
      <source media="(min-width: 40rem)" srcset="https://picsum.photos/seed/mid/800/450">
      <img src="https://picsum.photos/seed/small/480/360" alt="A landscape cropped for the current screen" width="480" height="360">
    </picture>
    <p>srcset with densities:</p>
    <img class="dense" src="https://picsum.photos/seed/d1/400/200" srcset="https://picsum.photos/seed/d1/400/200 1x, https://picsum.photos/seed/d1/800/400 2x" alt="A landscape at the screen's pixel density" width="400" height="200">
  </main>
</body>
</html>
