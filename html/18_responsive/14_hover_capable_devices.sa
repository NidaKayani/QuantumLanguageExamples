<!DOCTYPE html>
<!-- Quantum HTML + CSS example 18_responsive/14: Hover-capable devices -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Hover-capable devices</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .btn { display: inline-block; padding: 0.8rem 1.4rem; border-radius: 10px; background: #0ea5e9; color: #fff; text-decoration: none; font-weight: 700; }
    @media (hover: hover) { .btn:hover { background: #0284c7; transform: translateY(-2px); } }
    @media (pointer: coarse) { .btn { padding: 1rem 1.8rem; } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Hover-capable devices</h1>
    <p class="lead">@media (hover: hover) only adds hover effects where a pointer can hover.</p>
    <a class="btn" href="#go">Bigger on touch screens</a>
  </main>
</body>
</html>
