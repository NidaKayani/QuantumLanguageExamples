<!DOCTYPE html>
<!-- Quantum HTML + CSS example 18_responsive/17: Fluid spacing -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Fluid spacing</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .section { padding: clamp(1rem, 4vw, 4rem); background: #fff; border-radius: 16px; }
    .items { display: flex; flex-wrap: wrap; gap: clamp(0.5rem, 2vw, 2rem); }
    .items span { padding: 1rem; background: #ddd6fe; border-radius: 10px; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Fluid spacing</h1>
    <p class="lead">clamp() for padding and gaps that grow with the screen.</p>
    <section class="section"><div class="items"><span>One</span><span>Two</span><span>Three</span><span>Four</span></div></section>
  </main>
</body>
</html>
