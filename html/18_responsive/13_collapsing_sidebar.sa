<!DOCTYPE html>
<!-- Quantum HTML + CSS example 18_responsive/13: Collapsing sidebar -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Collapsing sidebar</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .layout { display: grid; gap: 1rem; }
    .layout aside, .layout main { background: #fff; border-radius: 12px; padding: 1rem; }
    @media (min-width: 48rem) { .layout { grid-template-columns: 15rem 1fr; } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Collapsing sidebar</h1>
    <p class="lead">A sidebar beside the content on wide screens, above it on narrow ones.</p>
    <div class="layout"><aside><h2>Filters</h2><p>Price, size, colour</p></aside><main><h2>Results</h2><p>24 products</p></main></div>
  </main>
</body>
</html>
