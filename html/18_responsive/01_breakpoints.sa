<!DOCTYPE html>
<!-- Quantum HTML + CSS example 18_responsive/01: Breakpoints -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Breakpoints</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .panel { padding: 2rem; border-radius: 16px; background: #fecaca; text-align: center; font-weight: 700; }
    .panel::after { content: "Small screen"; }
    @media (min-width: 40rem) { .panel { background: #fde68a; } .panel::after { content: "Medium screen"; } }
    @media (min-width: 64rem) { .panel { background: #bbf7d0; } .panel::after { content: "Large screen"; } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Breakpoints</h1>
    <p class="lead">The page colour changes at 40rem and 64rem.</p>
    <div class="panel">Resize the window: </div>
  </main>
</body>
</html>
