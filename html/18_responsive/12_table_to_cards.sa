<!DOCTYPE html>
<!-- Quantum HTML + CSS example 18_responsive/12: Table to cards -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Table to cards</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    table { width: 100%; border-collapse: collapse; background: #fff; }
    th, td { padding: 0.6rem; border-bottom: 1px solid #e2e8f0; text-align: left; }
    @media (max-width: 40rem) {
      thead { display: none; }
      table, tbody, tr, td { display: block; }
      tr { margin-bottom: 0.75rem; border-radius: 10px; box-shadow: 0 1px 4px rgb(0 0 0 / 0.1); }
      td::before { content: attr(data-label) ": "; font-weight: 700; }
    }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Table to cards</h1>
    <p class="lead">On narrow screens each table row becomes a card.</p>
    <table>
      <thead><tr><th>Name</th><th>Role</th><th>City</th></tr></thead>
      <tbody>
        <tr><td data-label="Name">Ayesha</td><td data-label="Role">Designer</td><td data-label="City">Lahore</td></tr>
        <tr><td data-label="Name">Bilal</td><td data-label="Role">Developer</td><td data-label="City">Karachi</td></tr>
        <tr><td data-label="Name">Sara</td><td data-label="Role">Writer</td><td data-label="City">Islamabad</td></tr>
      </tbody>
    </table>
  </main>
</body>
</html>
