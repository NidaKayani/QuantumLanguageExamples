<!DOCTYPE html>
<!-- Quantum HTML + CSS example 21_page_layouts/10: Resume -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Resume</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .cv { display: grid; grid-template-columns: 1fr 2fr; background: #fff; border-radius: 16px; overflow: hidden; }
    .cv aside { background: #1e293b; color: #e2e8f0; padding: 2rem; }
    .cv aside h2 { margin-top: 0; color: #fff; }
    .cv main { padding: 2rem; }
    .cv h3 { border-bottom: 2px solid #e2e8f0; padding-bottom: 0.3rem; }
    .job { margin-bottom: 1rem; }
    .job p { margin: 0.2rem 0; }
    .skills { list-style: none; padding: 0; }
    .skills li { margin: 0.4rem 0; }
    @media (max-width: 40rem) { .cv { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Resume</h1>
    <p class="lead">A one-page CV with sections and a sidebar.</p>
    <article class="cv">
      <aside><h2>Bilal Ahmed</h2><p>Front-end developer</p><p>bilal@example.com<br>Karachi</p><h3>Skills</h3><ul class="skills"><li>HTML &amp; CSS</li><li>Accessibility</li><li>Design systems</li></ul></aside>
      <main>
        <h3>Experience</h3>
        <div class="job"><strong>Senior developer, Bright Apps</strong><p>2022 &ndash; now</p><p>Led the redesign of a banking app used by two million people.</p></div>
        <div class="job"><strong>Developer, Pixel Studio</strong><p>2019 &ndash; 2022</p><p>Built marketing sites for 30 clients.</p></div>
        <h3>Education</h3><p>BSc Computer Science, 2019</p>
      </main>
    </article>
  </main>
</body>
</html>
