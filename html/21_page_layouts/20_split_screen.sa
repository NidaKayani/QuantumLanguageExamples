<!DOCTYPE html>
<!-- Quantum HTML + CSS example 21_page_layouts/20: Split screen -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Split screen</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .split { display: grid; grid-template-columns: 1fr 1fr; min-height: 26rem; border-radius: 20px; overflow: hidden; background: #fff; }
    .split .art { background: linear-gradient(160deg, #f97316, #db2777); color: #fff; padding: 2rem; display: flex; align-items: flex-end; }
    .split .side { padding: 2rem; display: flex; flex-direction: column; justify-content: center; }
    @media (max-width: 40rem) { .split { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Split screen</h1>
    <p class="lead">Two halves: a picture and a form.</p>
    <div class="split"><div class="art"><h2>Join 10,000 makers</h2></div><div class="side"><h2>Create your account</h2><p>It takes less than a minute.</p></div></div>
  </main>
</body>
</html>
