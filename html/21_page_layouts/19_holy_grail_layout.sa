<!DOCTYPE html>
<!-- Quantum HTML + CSS example 21_page_layouts/19: Holy grail layout -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Holy grail layout</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .grail { display: grid; min-height: 26rem; gap: 0.75rem; grid-template: "head head head" auto "nav main ads" 1fr "foot foot foot" auto / 10rem 1fr 10rem; }
    .grail > * { background: #fff; border-radius: 12px; padding: 1rem; }
    .grail header { grid-area: head; background: #4f46e5; color: #fff; }
    .grail nav { grid-area: nav; } .grail main { grid-area: main; } .grail aside { grid-area: ads; }
    .grail footer { grid-area: foot; background: #1e293b; color: #fff; }
    @media (max-width: 44rem) { .grail { grid-template: "head" "nav" "main" "ads" "foot" / 1fr; } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Holy grail layout</h1>
    <p class="lead">Header, footer and three columns with grid areas.</p>
    <div class="grail"><header>Header</header><nav aria-label="Side">Navigation</nav><main>Main content</main><aside>Sidebar</aside><footer>Footer</footer></div>
  </main>
</body>
</html>
