<!DOCTYPE html>
<!-- Quantum HTML + CSS example 21_page_layouts/06: Product page -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Product page</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .site-header { display: flex; justify-content: space-between; align-items: center; padding: 1rem 0; }
    .site-header nav a { margin-left: 1.25rem; color: #334155; text-decoration: none; }
    .logo { font-weight: 800; font-size: 1.2rem; color: #0f172a; text-decoration: none; }
    .site-footer { margin-top: 3rem; padding: 1.5rem 0; border-top: 1px solid #e2e8f0; color: #64748b; font-size: 0.9rem; }
    .product { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 2rem; }
    .product img { width: 100%; height: auto; border-radius: 16px; }
    .price { font-size: 2rem; font-weight: 800; }
    .sizes { display: flex; gap: 0.5rem; border: 0; padding: 0; }
    .sizes label { padding: 0.5rem 0.9rem; border: 1px solid #cbd5e1; border-radius: 8px; cursor: pointer; }
    .sizes label:has(input:checked) { border-color: #0f172a; background: #0f172a; color: #fff; }
    .sizes input { position: absolute; opacity: 0; }
    .add { margin-top: 1rem; padding: 0.9rem 1.6rem; border: 0; border-radius: 12px; background: #16a34a; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Product page</h1>
    <p class="lead">Gallery, details, price and an add-to-cart form.</p>
    <header class="site-header"><a class="logo" href="#top">Shop</a><nav aria-label="Main"><a href="#new">New</a><a href="#men">Men</a><a href="#women">Women</a></nav></header>
    <section class="product">
      <img src="https://picsum.photos/seed/shoe/800/800" alt="A white running shoe" width="800" height="800">
      <div>
        <h2>Cloud runner</h2><p class="price">$89</p><p>Light, breathable and ready for long runs.</p>
        <form action="#">
          <fieldset class="sizes"><legend>Size</legend><label><input type="radio" name="size" value="40">40</label><label><input type="radio" name="size" value="41">41</label><label><input type="radio" name="size" value="42" checked>42</label><label><input type="radio" name="size" value="43">43</label><label><input type="radio" name="size" value="44">44</label></fieldset>
          <button class="add" type="submit">Add to cart</button>
        </form>
      </div>
    </section>
    <footer class="site-footer"><p>&copy; 2026 Quantum Logics Labs. Made with HTML and CSS.</p></footer>
  </main>
</body>
</html>
