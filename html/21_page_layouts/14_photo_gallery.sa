<!DOCTYPE html>
<!-- Quantum HTML + CSS example 21_page_layouts/14: Photo gallery -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Photo gallery</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: 0.5rem; }
    .gallery a { display: block; aspect-ratio: 1; overflow: hidden; border-radius: 10px; }
    .gallery img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s, filter 0.3s; }
    .gallery a:hover img { transform: scale(1.08); filter: saturate(1.3); }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Photo gallery</h1>
    <p class="lead">A responsive grid of square thumbnails.</p>
    <section class="gallery" aria-label="Photos">
      <a href="#photo1"><img src="https://picsum.photos/seed/g1/400/400" alt="Gallery photo 1" width="400" height="400" loading="lazy"></a>
      <a href="#photo2"><img src="https://picsum.photos/seed/g2/400/400" alt="Gallery photo 2" width="400" height="400" loading="lazy"></a>
      <a href="#photo3"><img src="https://picsum.photos/seed/g3/400/400" alt="Gallery photo 3" width="400" height="400" loading="lazy"></a>
      <a href="#photo4"><img src="https://picsum.photos/seed/g4/400/400" alt="Gallery photo 4" width="400" height="400" loading="lazy"></a>
      <a href="#photo5"><img src="https://picsum.photos/seed/g5/400/400" alt="Gallery photo 5" width="400" height="400" loading="lazy"></a>
      <a href="#photo6"><img src="https://picsum.photos/seed/g6/400/400" alt="Gallery photo 6" width="400" height="400" loading="lazy"></a>
      <a href="#photo7"><img src="https://picsum.photos/seed/g7/400/400" alt="Gallery photo 7" width="400" height="400" loading="lazy"></a>
      <a href="#photo8"><img src="https://picsum.photos/seed/g8/400/400" alt="Gallery photo 8" width="400" height="400" loading="lazy"></a>
      <a href="#photo9"><img src="https://picsum.photos/seed/g9/400/400" alt="Gallery photo 9" width="400" height="400" loading="lazy"></a>
      <a href="#photo10"><img src="https://picsum.photos/seed/g10/400/400" alt="Gallery photo 10" width="400" height="400" loading="lazy"></a>
      <a href="#photo11"><img src="https://picsum.photos/seed/g11/400/400" alt="Gallery photo 11" width="400" height="400" loading="lazy"></a>
      <a href="#photo12"><img src="https://picsum.photos/seed/g12/400/400" alt="Gallery photo 12" width="400" height="400" loading="lazy"></a>
    </section>
  </main>
</body>
</html>
