<!DOCTYPE html>
<!-- Quantum HTML + CSS example 22_media_svg/02: Video element -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Video element</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    video { display: block; width: 100%; max-width: 40rem; border-radius: 14px; background: #000; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Video element</h1>
    <p class="lead">Native video with controls, a poster and captions.</p>
    <video controls width="640" height="360" poster="https://picsum.photos/seed/poster/640/360" preload="none">
      <source src="https://example.com/media/intro.webm" type="video/webm">
      <source src="https://example.com/media/intro.mp4" type="video/mp4">
      <track kind="captions" src="captions-en.vtt" srclang="en" label="English" default>
      <p>Your browser cannot play this video. <a href="https://example.com/media/intro.mp4">Download it</a>.</p>
    </video>
  </main>
</body>
</html>
