<!DOCTYPE html>
<!-- Quantum HTML + CSS example 22_media_svg/18: Canvas with fallback -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Canvas with fallback</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    canvas { display: block; width: 100%; max-width: 30rem; height: 12rem; border-radius: 14px; background: repeating-linear-gradient(45deg, #f1f5f9 0 12px, #e2e8f0 12px 24px); }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Canvas with fallback</h1>
    <p class="lead">canvas content is shown only where canvas is unsupported.</p>
    <canvas width="480" height="192">
      <p>A drawing appears here when JavaScript draws on the canvas.</p>
    </canvas>
  </main>
</body>
</html>
