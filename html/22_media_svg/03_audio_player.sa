<!DOCTYPE html>
<!-- Quantum HTML + CSS example 22_media_svg/03: Audio player -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Audio player</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .player { background: #fff; border-radius: 14px; padding: 1rem 1.25rem; max-width: 28rem; }
    audio { width: 100%; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Audio player</h1>
    <p class="lead">audio with several sources and a fallback link.</p>
    <section class="player"><h2>Episode 7: Layout tricks</h2>
    <audio controls preload="none">
      <source src="https://example.com/podcast/ep7.ogg" type="audio/ogg">
      <source src="https://example.com/podcast/ep7.mp3" type="audio/mpeg">
      <a href="https://example.com/podcast/ep7.mp3">Download the episode</a>
    </audio></section>
  </main>
</body>
</html>
