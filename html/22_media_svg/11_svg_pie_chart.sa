<!DOCTYPE html>
<!-- Quantum HTML + CSS example 22_media_svg/11: SVG pie chart -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SVG pie chart</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .pie { display: flex; gap: 2rem; align-items: center; flex-wrap: wrap; background: #fff; border-radius: 16px; padding: 1.5rem; }
    .pie svg { width: 14rem; height: 14rem; }
    .pie ul { list-style: none; padding: 0; }
    .pie li { display: flex; align-items: center; gap: 0.5rem; margin: 0.4rem 0; }
    .pie li span { width: 1rem; height: 1rem; border-radius: 4px; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>SVG pie chart</h1>
    <p class="lead">Arc paths computed from percentages.</p>
    <div class="pie"><svg viewBox="0 0 200 200" role="img" aria-label="Share of code by language"><path d="M100 100 L100.0 20.0 A80 80 0 0 1 164.7 147.0 Z" fill="#f97316"/><path d="M100 100 L164.7 147.0 A80 80 0 0 1 35.3 147.0 Z" fill="#3b82f6"/><path d="M100 100 L35.3 147.0 A80 80 0 0 1 35.3 53.0 Z" fill="#facc15"/><path d="M100 100 L35.3 53.0 A80 80 0 0 1 100.0 20.0 Z" fill="#94a3b8"/></svg><ul><li><span style="background: #f97316"></span>HTML 35%</li><li><span style="background: #3b82f6"></span>CSS 30%</li><li><span style="background: #facc15"></span>JavaScript 20%</li><li><span style="background: #94a3b8"></span>Other 15%</li></ul></div>
  </main>
</body>
</html>
