<!DOCTYPE html>
<!-- Quantum HTML + CSS example 22_media_svg/06: SVG gradients -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SVG gradients</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .art { background: #fff; border-radius: 16px; padding: 1rem; } .art svg { display: block; width: 100%; max-width: 26rem; height: auto; margin: 0 auto; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>SVG gradients</h1>
    <p class="lead">linearGradient and radialGradient defined once, used as fills.</p>
    <div class="art"><svg viewBox="0 0 400 200" role="img" aria-label="Gradient shapes">
      <defs>
        <linearGradient id="sky" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#22d3ee"/><stop offset="1" stop-color="#6366f1"/></linearGradient>
        <radialGradient id="sun"><stop offset="0" stop-color="#fef08a"/><stop offset="1" stop-color="#f97316"/></radialGradient>
      </defs>
      <rect x="10" y="10" width="220" height="180" rx="20" fill="url(#sky)"/>
      <circle cx="310" cy="100" r="80" fill="url(#sun)"/>
    </svg></div>
  </main>
</body>
</html>
