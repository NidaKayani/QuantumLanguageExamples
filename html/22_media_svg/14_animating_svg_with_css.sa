<!DOCTYPE html>
<!-- Quantum HTML + CSS example 22_media_svg/14: Animating SVG with CSS -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Animating SVG with CSS</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .art { background: #fff; border-radius: 16px; padding: 1rem; } .art svg { display: block; width: 100%; max-width: 26rem; height: auto; margin: 0 auto; }
    .gear { transform-origin: 100px 100px; animation: turn 6s linear infinite; }
    .glow { animation: glow 2s ease-in-out infinite alternate; }
    @keyframes turn { to { transform: rotate(360deg); } }
    @keyframes glow { to { fill: #f97316; } }
    @media (prefers-reduced-motion: reduce) { .gear, .glow { animation: none; } }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Animating SVG with CSS</h1>
    <p class="lead">CSS keyframes rotate and colour SVG elements.</p>
    <div class="art"><svg viewBox="0 0 200 200" role="img" aria-label="A spinning gear">
      <g class="gear"><circle cx="100" cy="100" r="50" fill="none" stroke="#334155" stroke-width="22" stroke-dasharray="20 12"/></g>
      <circle class="glow" cx="100" cy="100" r="22" fill="#facc15"/>
    </svg></div>
  </main>
</body>
</html>
