<!DOCTYPE html>
<!-- Quantum HTML + CSS example 22_media_svg/10: SVG line chart -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SVG line chart</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .art { background: #fff; border-radius: 16px; padding: 1rem; } .art svg { display: block; width: 100%; max-width: 26rem; height: auto; margin: 0 auto; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>SVG line chart</h1>
    <p class="lead">A polyline through monthly temperatures.</p>
    <div class="art"><svg viewBox="0 0 400 200" role="img" aria-label="Temperatures peak in July">
      <polyline points="20,162 53,150 86,126 119,96 152,72 185,48 218,30 251,36 284,60 317,96 350,132 383,156" fill="none" stroke="#f97316" stroke-width="3" stroke-linejoin="round"/>
      <circle cx="20" cy="162" r="4" fill="#ef4444"/><circle cx="53" cy="150" r="4" fill="#ef4444"/><circle cx="86" cy="126" r="4" fill="#ef4444"/><circle cx="119" cy="96" r="4" fill="#ef4444"/><circle cx="152" cy="72" r="4" fill="#ef4444"/><circle cx="185" cy="48" r="4" fill="#ef4444"/><circle cx="218" cy="30" r="4" fill="#ef4444"/><circle cx="251" cy="36" r="4" fill="#ef4444"/><circle cx="284" cy="60" r="4" fill="#ef4444"/><circle cx="317" cy="96" r="4" fill="#ef4444"/><circle cx="350" cy="132" r="4" fill="#ef4444"/><circle cx="383" cy="156" r="4" fill="#ef4444"/>
    </svg></div>
  </main>
</body>
</html>
