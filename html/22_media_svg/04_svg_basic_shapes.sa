<!DOCTYPE html>
<!-- Quantum HTML + CSS example 22_media_svg/04: SVG basic shapes -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SVG basic shapes</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .art { background: #fff; border-radius: 16px; padding: 1rem; } .art svg { display: block; width: 100%; max-width: 26rem; height: auto; margin: 0 auto; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>SVG basic shapes</h1>
    <p class="lead">rect, circle, ellipse, line, polyline and polygon.</p>
    <div class="art"><svg viewBox="0 0 400 200" role="img" aria-label="Basic shapes">
      <rect x="10" y="20" width="80" height="60" rx="8" fill="#60a5fa"/>
      <circle cx="150" cy="50" r="35" fill="#f472b6"/>
      <ellipse cx="250" cy="50" rx="50" ry="28" fill="#34d399"/>
      <line x1="320" y1="20" x2="390" y2="90" stroke="#0f172a" stroke-width="6" stroke-linecap="round"/>
      <polyline points="10,180 60,120 110,160 160,110 210,170" fill="none" stroke="#f59e0b" stroke-width="5"/>
      <polygon points="300,110 340,190 260,190" fill="#a78bfa"/>
    </svg></div>
  </main>
</body>
</html>
