<!DOCTYPE html>
<!-- Quantum HTML + CSS example 22_media_svg/17: viewBox scaling -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>viewBox scaling</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .sizes { display: flex; gap: 1.5rem; align-items: flex-end; }
    .sizes svg { height: auto; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>viewBox scaling</h1>
    <p class="lead">One SVG at three sizes stays sharp.</p>
    <div class="sizes">
      <svg viewBox="0 0 100 100" width="48" height="48" role="img" aria-label="Smiley at 48 pixels"><circle cx="50" cy="50" r="46" fill="#facc15"/><circle cx="35" cy="40" r="6"/><circle cx="65" cy="40" r="6"/><path d="M30 62 Q50 80 70 62" fill="none" stroke="#000" stroke-width="5" stroke-linecap="round"/></svg>
      <svg viewBox="0 0 100 100" width="96" height="96" role="img" aria-label="Smiley at 96 pixels"><circle cx="50" cy="50" r="46" fill="#facc15"/><circle cx="35" cy="40" r="6"/><circle cx="65" cy="40" r="6"/><path d="M30 62 Q50 80 70 62" fill="none" stroke="#000" stroke-width="5" stroke-linecap="round"/></svg>
      <svg viewBox="0 0 100 100" width="192" height="192" role="img" aria-label="Smiley at 192 pixels"><circle cx="50" cy="50" r="46" fill="#facc15"/><circle cx="35" cy="40" r="6"/><circle cx="65" cy="40" r="6"/><path d="M30 62 Q50 80 70 62" fill="none" stroke="#000" stroke-width="5" stroke-linecap="round"/></svg>
    </div>
  </main>
</body>
</html>
