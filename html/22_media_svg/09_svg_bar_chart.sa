<!DOCTYPE html>
<!-- Quantum HTML + CSS example 22_media_svg/09: SVG bar chart -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SVG bar chart</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .art { background: #fff; border-radius: 16px; padding: 1rem; } .art svg { display: block; width: 100%; max-width: 26rem; height: auto; margin: 0 auto; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>SVG bar chart</h1>
    <p class="lead">Bars computed from data, with day labels.</p>
    <div class="art"><svg viewBox="0 0 400 200" role="img" aria-label="Sales by day: highest on Friday">
      <line x1="20" y1="170" x2="390" y2="170" stroke="#cbd5e1"/>
      <rect x="30" y="86" width="36" height="84" rx="4" fill="#6366f1"/><text x="48" y="190" text-anchor="middle" font-size="12" fill="#475569">Mon</text><rect x="80" y="37" width="36" height="133" rx="4" fill="#6366f1"/><text x="98" y="190" text-anchor="middle" font-size="12" fill="#475569">Tue</text><rect x="130" y="114" width="36" height="56" rx="4" fill="#6366f1"/><text x="148" y="190" text-anchor="middle" font-size="12" fill="#475569">Wed</text><rect x="180" y="65" width="36" height="105" rx="4" fill="#6366f1"/><text x="198" y="190" text-anchor="middle" font-size="12" fill="#475569">Thu</text><rect x="230" y="16" width="36" height="154" rx="4" fill="#6366f1"/><text x="248" y="190" text-anchor="middle" font-size="12" fill="#475569">Fri</text><rect x="280" y="51" width="36" height="119" rx="4" fill="#6366f1"/><text x="298" y="190" text-anchor="middle" font-size="12" fill="#475569">Sat</text><rect x="330" y="100" width="36" height="70" rx="4" fill="#6366f1"/><text x="348" y="190" text-anchor="middle" font-size="12" fill="#475569">Sun</text>
    </svg></div>
  </main>
</body>
</html>
