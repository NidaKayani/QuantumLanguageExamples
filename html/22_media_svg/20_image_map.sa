<!DOCTYPE html>
<!-- Quantum HTML + CSS example 22_media_svg/20: Image map -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Image map</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .mapped { max-width: 100%; height: auto; border-radius: 12px; }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Image map</h1>
    <p class="lead">Clickable regions on an image with map and area.</p>
    <img class="mapped" src="https://picsum.photos/seed/planets/400/200" alt="Three planets in a row" width="400" height="200" usemap="#planets">
    <map name="planets">
      <area shape="circle" coords="70,100,50" href="#mercury" alt="Mercury">
      <area shape="circle" coords="200,100,60" href="#venus" alt="Venus">
      <area shape="rect" coords="290,40,390,160" href="#earth" alt="Earth">
    </map>
  </main>
</body>
</html>
