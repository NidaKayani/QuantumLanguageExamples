<!DOCTYPE html>
<!-- Quantum HTML + CSS example 09_backgrounds_gradients/02: Multi-stop gradients -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Multi-stop gradients</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: 1rem; }
    .tiles div { height: 9rem; border-radius: 12px; display: flex; align-items: flex-end; padding: 0.6rem; font-size: 0.8rem; font-weight: 600; color: #fff; text-shadow: 0 1px 2px rgb(0 0 0 / 0.5); }
    .rainbow { background: linear-gradient(90deg, red, orange, yellow, green, blue, indigo, violet); }
    .hard { background: linear-gradient(90deg, #0ea5e9 33%, #fbbf24 33% 66%, #ef4444 66%); }
    .hint { background: linear-gradient(90deg, #111827, 20%, #e5e7eb); }
    .flag { background: linear-gradient(#000 0 33.3%, #dd0000 33.3% 66.6%, #ffce00 66.6%); }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Multi-stop gradients</h1>
    <p class="lead">Several colour stops, hard stops and hints.</p>
    <div class="tiles">
      <div class="rainbow">rainbow</div><div class="hard">hard stops</div><div class="hint">colour hint</div><div class="flag">a flag</div>
    </div>
  </main>
</body>
</html>
