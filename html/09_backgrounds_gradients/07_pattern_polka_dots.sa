<!DOCTYPE html>
<!-- Quantum HTML + CSS example 09_backgrounds_gradients/07: Pattern: Polka dots -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pattern: Polka dots</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .pattern { height: 18rem; border-radius: 16px; background: radial-gradient(circle, #f472b6 25%, transparent 26%) 0 0 / 2rem 2rem, #fdf2f8; box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.1); }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Pattern: Polka dots</h1>
    <p class="lead">A repeating pattern drawn only with gradients.</p>
    <div class="pattern" role="img" aria-label="polka dots pattern"></div>
  </main>
</body>
</html>
