<!DOCTYPE html>
<!-- Quantum HTML + CSS example 09_backgrounds_gradients/04: Conic gradients -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Conic gradients</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      color: #1f2933;
      background: #f5f7fa;
    }
    .demo { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem; }
    .demo > h1 { margin: 0 0 0.25rem; font-size: 2rem; }
    .lead { margin: 0 0 2rem; color: #52606d; }

    .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: 1rem; }
    .tiles div { height: 9rem; border-radius: 12px; display: flex; align-items: flex-end; padding: 0.6rem; font-size: 0.8rem; font-weight: 600; color: #fff; text-shadow: 0 1px 2px rgb(0 0 0 / 0.5); }
    .c1 { background: conic-gradient(red, yellow, lime, aqua, blue, magenta, red); border-radius: 50%; }
    .c2 { background: conic-gradient(#3b82f6 0 40%, #f59e0b 40% 70%, #10b981 70%); border-radius: 50%; }
    .c3 { background: conic-gradient(from 45deg, #0f172a, #38bdf8, #0f172a); }
    .c4 { background: repeating-conic-gradient(#f43f5e 0 15deg, #fff1f2 15deg 30deg); }
  </style>
</head>
<body>
  <main class="demo">
    <h1>Conic gradients</h1>
    <p class="lead">Colours swept around a centre: wheels, pies and spinners.</p>
    <div class="tiles">
      <div class="c1">colour wheel</div><div class="c2">pie chart</div><div class="c3">from 45deg</div><div class="c4">sunburst</div>
    </div>
  </main>
</body>
</html>
